# ==============================================================================
# Naseer Plywood & Hardware — Production Environment Configuration Template
# DO NOT COMMIT THE POPULATED FILE (.env.production) TO VERSION CONTROL.
# Generate production secrets using: python3 scripts/generate_secrets.py --env-file .env.production
# ==============================================================================

# Application Environment
APP_ENV=production
DEBUG=False

# Host Ports (Nginx terminates standard HTTP 80 and HTTPS 443)
HTTP_PORT=80
HTTPS_PORT=443

# PostgreSQL Production Configuration (Never expose 5432 to public host)
POSTGRES_DB=hardware_db
POSTGRES_USER=hardware_prod_user
POSTGRES_PASSWORD=GENERATE_POSTGRES_PASSWORD_HERE
POSTGRES_HOST=hardware-postgres
POSTGRES_PORT=5432

# SQLAlchemy Connection String
DATABASE_URL=postgresql+psycopg://hardware_prod_user:GENERATE_POSTGRES_PASSWORD_HERE@hardware-postgres:5432/hardware_db

# Security & Authentication
# High-entropy JWT signature key (minimum 32 bytes, recommended 64-char urlsafe)
SECRET_KEY=GENERATE_SECRET_KEY_HERE
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
INVITATION_TOKEN_EXPIRE_HOURS=72

# Initial Super Admin Bootstrap Password (one-time use, rotate immediately)
ADMIN_INITIAL_PASSWORD=GENERATE_ADMIN_INITIAL_PASSWORD_HERE

# Production Domain & CORS Origins (Strict allowlist, no wildcards)
PRODUCTION_DOMAIN=naseerhardware.duckdns.org
ALLOWED_ORIGINS=https://naseerhardware.duckdns.org
PUBLIC_SITE_URL=https://naseerhardware.duckdns.org
PUBLIC_API_URL=https://naseerhardware.duckdns.org/api/v1

# Persistent Storage Paths
MEDIA_STORAGE_PATH=/data/media
SSL_CERT_PATH=/etc/letsencrypt/live/naseerhardware.duckdns.org

# Google Search Console Verification Meta Tag (Optional)
PUBLIC_GSC_VERIFICATION=

# Business NAP & Showroom Contact Data (Canal Road, Sargodha)
STORE_NAME_EN=Naseer Plywood & Hardware
STORE_NAME_UR=نصیر پلائی ووڈ اینڈ ہارڈویئر
STORE_PHONE=+92-304-5030046
STORE_WHATSAPP=+923045030046
STORE_ADDRESS_EN=Near New Cantt Hospital, Canal Road / General Bus Stand Road, Sargodha, Punjab, Pakistan
STORE_ADDRESS_UR=نزد نیو کینٹ ہسپتال کینال روڈ / جنرل بس اسٹینڈ روڈ، سرگودھا، پنجاب، پاکستان
