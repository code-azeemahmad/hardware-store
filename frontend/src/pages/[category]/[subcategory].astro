---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/astro/ProductCard.astro';
import {
  fetchPublishedCategories,
  getProductsBySubcategory,
  type Category,
  type Subcategory,
} from '../../lib/api';

export async function getStaticPaths() {
  const categories = await fetchPublishedCategories();
  const paths: {
    params: { category: string; subcategory: string };
    props: {
      category: Category;
      subcategory: Subcategory;
      isAlias?: boolean;
      canonicalSubSlug?: string;
    };
  }[] = [];

  categories.forEach((cat) => {
    cat.subcategories.forEach((sub) => {
      // Primary canonical route
      paths.push({
        params: { category: cat.slug, subcategory: sub.slug },
        props: { category: cat, subcategory: sub, isAlias: false, canonicalSubSlug: sub.slug },
      });
      if (sub.slug.startsWith(`${cat.slug}-`)) {
        const shortSlug = sub.slug.replace(`${cat.slug}-`, '');
        paths.push({
          params: { category: cat.slug, subcategory: shortSlug },
          props: { category: cat, subcategory: sub, isAlias: true, canonicalSubSlug: sub.slug },
        });
      }
      if (sub.slug.startsWith('door-')) {
        const shortSlug = sub.slug.replace('door-', '');
        paths.push({
          params: { category: cat.slug, subcategory: shortSlug },
          props: { category: cat, subcategory: sub, isAlias: true, canonicalSubSlug: sub.slug },
        });
      }
    });
  });

  return paths;
}

interface Props {
  category: Category;
  subcategory: Subcategory;
  isAlias?: boolean;
  canonicalSubSlug?: string;
}

const { category, subcategory, isAlias = false, canonicalSubSlug = subcategory.slug } = Astro.props;
const lang = 'en';
const products = await getProductsBySubcategory(category.slug, subcategory.slug);

const canonicalPath = `/${category.slug}/${canonicalSubSlug}/`;
const redirectUrl = isAlias ? canonicalPath : undefined;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: category.nameEn, url: `/${category.slug}/` },
  { name: subcategory.nameEn, url: canonicalPath },
];

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": `${subcategory.nameEn} | ${category.nameEn} | Naseer Plywood & Hardware`,
  "description": subcategory.descriptionEn,
  "url": canonicalPath,
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": products.length,
    "itemListElement": products.map((p, idx) => ({
      "@type": "ListItem",
      "position": idx + 1,
      "url": `/products/${p.slug}/`,
      "name": p.titleEn,
    })),
  },
};
---

<BaseLayout
  title={`${subcategory.nameEn} | ${category.nameEn} | Naseer Plywood & Hardware`}
  description={subcategory.descriptionEn}
  lang={lang}
  canonicalPath={canonicalPath}
  redirectUrl={redirectUrl}
  breadcrumbs={breadcrumbs}
  collectionSchema={collectionSchema}
>
  <!-- Subcategory Header & Breadcrumbs -->
  <section class="subcategory-header">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="sep">/</span>
        <a href={`/${category.slug}/`}>{category.nameEn}</a>
        <span class="sep">/</span>
        <span class="current">{subcategory.nameEn}</span>
      </nav>

      <h1 class="subcategory-title">{subcategory.nameEn}</h1>
      <p class="subcategory-desc">{subcategory.descriptionEn}</p>
    </div>
  </section>

  <!-- Filter & Sort Bar -->
  <section class="filter-toolbar-section">
    <div class="container filter-toolbar">
      <div class="filter-left">
        <span class="filter-count">
          Showing <strong>{products.length}</strong> items in stock
        </span>
      </div>

      <div class="filter-right">
        <label class="sort-label">
          <span>Sort:</span>
          <select class="sort-select" aria-label="Sort subcategory items">
            <option value="featured">Showroom Selection</option>
            <option value="bestseller">Best Selling First</option>
            <option value="name-asc">Title: A to Z</option>
          </select>
        </label>
      </div>
    </div>
  </section>

  <!-- Product Grid -->
  <div class="container catalogue-grid-wrap">
    <h2 class="sr-only">Available Products in {subcategory.nameEn}</h2>
    {products.length > 0 ? (
      <div class="product-cards-grid">
        {products.map((p) => (
          <ProductCard
            title={p.titleEn}
            category={subcategory.nameEn}
            brand={p.brand}
            slug={p.slug}
            imageUrl={p.imageUrl}
            lang={lang}
          />
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <p>Currently updating display samples for this category. Inquire on WhatsApp for immediate availability.</p>
        <a href="https://wa.me/923045030046" class="whatsapp-btn" target="_blank" rel="noopener noreferrer">
          Ask via WhatsApp
        </a>
      </div>
    )}

    <!-- Reference Pagination -->
    <nav class="pagination-bar" aria-label="Pagination">
      <span class="page-num active">1</span>
    </nav>
  </div>
</BaseLayout>

<style>
  .subcategory-header {
    background-color: var(--color-surface-light);
    border-bottom: 1px solid var(--color-border);
    padding: 2.25rem 0 1.75rem;
  }
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
  }
  .breadcrumb a {
    color: var(--color-surface-black);
    text-decoration: none;
    font-weight: 500;
  }
  .breadcrumb a:hover {
    color: var(--color-primary-red);
  }
  .breadcrumb .sep {
    color: var(--color-border-hover);
  }
  .subcategory-title {
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-surface-black);
    margin-bottom: 0.5rem;
    letter-spacing: -0.02em;
  }
  .subcategory-desc {
    font-size: 1rem;
    color: var(--color-text-muted);
    max-width: 750px;
    line-height: 1.5;
  }
  .filter-toolbar-section {
    border-bottom: 1px solid var(--color-border);
    background-color: var(--color-surface-white);
    padding: 0.85rem 0;
  }
  .filter-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .filter-count {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }
  .filter-count strong {
    color: var(--color-surface-black);
  }
  .sort-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }
  .sort-select {
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-size: 0.875rem;
  }
  .catalogue-grid-wrap {
    padding-top: 2rem;
    padding-bottom: 3.5rem;
  }
  .product-cards-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    margin-bottom: 2rem;
  }
  @media (max-width: 1024px) {
    .product-cards-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }
  }
  @media (max-width: 768px) {
    .product-cards-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
  }
  @media (max-width: 480px) {
    .product-cards-grid {
      grid-template-columns: 1fr;
    }
  }
  .empty-state {
    text-align: center;
    padding: 3rem 1.5rem;
    background-color: var(--color-surface-light);
    border-radius: var(--radius-md);
  }
  .empty-state p {
    color: var(--color-text-muted);
    margin-bottom: 1.25rem;
  }
  .whatsapp-btn {
    display: inline-flex;
    padding: 0.65rem 1.5rem;
    background-color: #25d366;
    color: #ffffff;
    font-weight: 700;
    border-radius: var(--radius-full);
    text-decoration: none;
  }
  .pagination-bar {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }
  .page-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-weight: 600;
    background-color: var(--color-surface-black);
    color: #ffffff;
  }
</style>
