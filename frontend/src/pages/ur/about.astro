---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SocialBar from '../../components/astro/SocialBar.astro';

const lang = 'ur';

const breadcrumbs = [
  { name: 'ہوم', url: '/ur/' },
  { name: 'ہمارے متعلق', url: '/ur/about/' },
];
---

<BaseLayout
  title="ہمارے متعلق | نصیر پلائی ووڈ اینڈ ہارڈویئر سرگودھا"
  description="نصیر پلائی ووڈ اینڈ ہارڈویئر، سرگودھا کا سب سے بڑا اور قابل اعتماد ہارڈویئر، ڈور لاکس، کچن سنک اور میرین پلائی ووڈ کا مرکز۔"
  lang={lang}
  breadcrumbs={breadcrumbs}
>
  <div class="about-page">
    <div class="container">
      <!-- Breadcrumbs -->
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/ur/">ہوم</a>
        <span class="sep">/</span>
        <span class="current">ہمارے متعلق</span>
      </nav>

      <!-- Page Header -->
      <header class="about-header">
        <span class="badge-subtitle">سرگودھا کا قابل اعتماد شوروم</span>
        <h1 class="page-title">نصیر پلائی ووڈ اینڈ ہارڈویئر کا تعارف</h1>
        <div class="red-line"></div>
        <p class="lead-text">
          سرگودھا، پنجاب اور گردونواح کے علاقوں میں اعلیٰ کوالٹی آرکیٹیکچرل ہارڈویئر، امپورٹڈ کچن و باتھ روم فٹنگز اور واٹر پروف میرین پلائی ووڈ کی فراہمی کا معتبر نام۔
        </p>
      </header>

      <!-- Two-Column Story Section -->
      <section class="story-section">
        <div class="story-text">
          <h2>ہمارا سفر اور شوروم کا عزم</h2>
          <p>
            کینال روڈ (نزد جنرل بس اسٹینڈ روڈ) سرگودھا پر واقع، <strong>نصیر پلائی ووڈ اینڈ ہارڈویئر</strong> کنٹریکٹرز، کارپینٹرز، انٹیرئیر ڈیزائنرز اور اپنے گھر بنانے والے معزز شہریوں کے لیے ایک مکمل اور بھروسہ مند نام ہے۔
          </p>
          <p>
            ہماری ترجیح صرف اشیاء فروخت کرنا نہیں بلکہ گاہکوں کو درست، پائیدار اور اصلی برانڈز فراہم کرنا ہے۔ ہمارے فزیکل شوروم پر تمام مصنوعات کے لائیو ڈسپلے موجود ہیں تاکہ خریدار اپنی تسلی سے انتخاب کر سکیں۔
          </p>
          <p>
            ہم بلڈرز اور کنٹریکٹرز کے لیے ہول سیل ریٹس پر بلک سپلائی فراہم کرتے ہیں اور تمام میٹیریل کی کوالٹی کی مکمل گارنٹی دیتے ہیں۔
          </p>
        </div>

        <div class="story-image-wrap">
          <img
            src="/images/gate.jpg"
            alt="نصیر پلائی ووڈ اینڈ ہارڈویئر شوروم، سرگودھا"
            width="800"
            height="500"
            loading="lazy"
            decoding="async"
            class="story-img"
          />
          <div class="caption-overlay">
            <span>کینال روڈ شوروم، سرگودھا</span>
          </div>
        </div>
      </section>

      <!-- 4 Core Pillars Grid -->
      <section class="pillars-section">
        <h2 class="section-title">ہمارا انتخاب کیوں کیا جاتا ہے؟</h2>
        <div class="pillars-grid">
          <div class="pillar-card">
            <div class="pillar-icon">01</div>
            <h3>100% تصدیق شدہ اصلی برانڈز</h3>
            <p>کوئی جعلی یا ناقص مال نہیں۔ ہم صرف معتبر امپورٹرز اور کمپنیوں کا تصدیق شدہ مال فروخت کرتے ہیں۔</p>
          </div>

          <div class="pillar-card">
            <div class="pillar-icon">02</div>
            <h3>شفاف ہول سیل نرخ</h3>
            <p>کنٹریکٹرز اور بڑے پراجیکٹس کے لیے ہول سیل مارکیٹ ریٹس اور گھریلو خریداروں کے لیے مناسب قیمت۔</p>
          </div>

          <div class="pillar-card">
            <div class="pillar-icon">03</div>
            <h3>تکنیکی و کاریگرانہ مشورہ</h3>
            <p>صحیح لکڑی، واٹر پروف شیٹس اور دروازوں کے وزن کے حساب سے قبضوں کے انتخاب میں تجربہ کار ٹیم کی رہنمائی۔</p>
          </div>

          <div class="pillar-card">
            <div class="pillar-icon">04</div>
            <h3>محفوظ ہینڈلنگ اور سائیٹ ڈیلیوری</h3>
            <p>پلائی ووڈ شیٹس اور نازک سینیٹری ویئر کی باحفاظت ترسیل اور گاڑیوں پر لوڈنگ کی مکمل سہولت۔</p>
          </div>
        </div>
      </section>

      <!-- Gallery Grid of Real Shop Displays -->
      <section class="shop-gallery-section">
        <h2 class="section-title">شوروم کے تصویری مناظر</h2>
        <div class="gallery-grid">
          <div class="gallery-item">
            <img src="/images/crafts.jpg" alt="ڈور ہارڈویئر اور تالوں کا ڈسپلے" />
            <div class="gallery-info">
              <h4>ہارڈویئر اور ڈور لاکس سیکشن</h4>
              <p>اسمارٹ ڈیجیٹل لاکس، براس ہینڈلز اور سیکورٹی تالے</p>
            </div>
          </div>

          <div class="gallery-item">
            <img src="/images/shelf.jpg" alt="کچن سنک اور سینیٹری ویئر" />
            <div class="gallery-info">
              <h4>کچن اور سینیٹری فکسچرز</h4>
              <p>اسٹین لیس اسٹیل سنک، ٹونٹیاں، وینٹیز اور اوونز</p>
            </div>
          </div>

          <div class="gallery-item">
            <img src="/images/wood.jpg" alt="پلائی ووڈ شیٹس اور بورڈز" />
            <div class="gallery-info">
              <h4>پلائی ووڈ و لکڑی کے بورڈز</h4>
              <p>کمرشل پلائی ووڈ، واٹر پروف میرین شیٹس اور ایم ڈی ایف</p>
            </div>
          </div>
        </div>
      </section>

      <!-- CTA Banner -->
      <section class="about-cta-banner">
        <h2>کیا آپ نیا گھر یا کمرشل پراجیکٹ شروع کر رہے ہیں؟</h2>
        <p>ہمارے شوروم پر تشریف لائیں یا اپنی میٹیریل لسٹ واٹس ایپ پر ارسال کریں تاکہ ہم فوری کوٹیشن دے سکیں۔</p>
        <div class="cta-actions">
          <a href="https://wa.me/923177030847" class="btn-whatsapp" target="_blank" rel="noopener noreferrer">
            واٹس ایپ پر رابطہ کریں (0317-7030847)
          </a>
          <a href="/ur/contact/" class="btn-contact">
            شوروم کی لوکیشن دیکھیں
          </a>
        </div>
      </section>
    </div>
  </div>

  <SocialBar lang={lang} />
</BaseLayout>

<style>
  .about-page {
    padding-top: 1.5rem;
    padding-bottom: 4rem;
  }
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
  }
  .breadcrumb a {
    color: var(--color-surface-black);
    text-decoration: none;
    font-weight: 600;
  }
  .breadcrumb a:hover {
    color: var(--color-primary-red);
  }
  .breadcrumb .sep {
    color: var(--color-border-hover);
  }
  .about-header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 3.5rem;
  }
  .badge-subtitle {
    display: inline-block;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--color-primary-red);
    background-color: #fee2e2;
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
    margin-bottom: 0.75rem;
  }
  .page-title {
    font-size: 2.75rem;
    font-weight: 800;
    color: var(--color-surface-black);
    margin-bottom: 0.5rem;
  }
  .red-line {
    width: 60px;
    height: 3px;
    background-color: var(--color-primary-red);
    margin: 0.75rem auto 1.5rem;
  }
  .lead-text {
    font-size: 1.25rem;
    color: var(--color-text-muted);
    line-height: 1.8;
  }
  .story-section {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 3.5rem;
    align-items: center;
    margin-bottom: 5rem;
  }
  @media (max-width: 900px) {
    .story-section {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
  .story-text h2 {
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-surface-black);
    margin-bottom: 1.25rem;
  }
  .story-text p {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    line-height: 1.85;
    margin-bottom: 1.25rem;
  }
  .story-image-wrap {
    position: relative;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.12);
  }
  .story-img {
    width: 100%;
    height: 100%;
    max-height: 420px;
    object-fit: cover;
    display: block;
  }
  .caption-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.8), transparent);
    color: #ffffff;
    padding: 1.5rem 1.25rem 0.85rem;
    font-size: 0.95rem;
    font-weight: 600;
  }
  .pillars-section {
    margin-bottom: 5rem;
  }
  .section-title {
    font-size: 2.15rem;
    font-weight: 800;
    color: var(--color-surface-black);
    text-align: center;
    margin-bottom: 2.5rem;
  }
  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }
  @media (max-width: 1024px) {
    .pillars-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .pillars-grid {
      grid-template-columns: 1fr;
    }
  }
  .pillar-card {
    background-color: var(--color-surface-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 2rem 1.5rem;
    transition: transform var(--transition-fast), border-color var(--transition-fast);
  }
  .pillar-card:hover {
    transform: translateY(-3px);
    border-color: var(--color-primary-red);
  }
  .pillar-icon {
    font-size: 1.75rem;
    font-weight: 900;
    color: var(--color-primary-red);
    margin-bottom: 1rem;
  }
  .pillar-card h3 {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-surface-black);
    margin-bottom: 0.75rem;
  }
  .pillar-card p {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }
  .shop-gallery-section {
    margin-bottom: 5rem;
  }
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  @media (max-width: 800px) {
    .gallery-grid {
      grid-template-columns: 1fr;
    }
  }
  .gallery-item {
    background-color: var(--color-surface-white);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .gallery-item img {
    width: 100%;
    height: 240px;
    object-fit: cover;
  }
  .gallery-info {
    padding: 1.25rem;
  }
  .gallery-info h4 {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-surface-black);
    margin-bottom: 0.25rem;
  }
  .gallery-info p {
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }
  .about-cta-banner {
    background-color: var(--color-surface-black);
    color: #ffffff;
    border-radius: var(--radius-lg);
    padding: 3.5rem 2rem;
    text-align: center;
  }
  .about-cta-banner h2 {
    font-size: 2rem;
    font-weight: 800;
    margin-bottom: 0.75rem;
  }
  .about-cta-banner p {
    font-size: 1.15rem;
    color: rgba(255, 255, 255, 0.85);
    max-width: 600px;
    margin: 0 auto 2rem;
    line-height: 1.8;
  }
  .cta-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .btn-whatsapp {
    background-color: var(--color-whatsapp);
    color: #ffffff;
    padding: 0.85rem 1.75rem;
    border-radius: var(--radius-full);
    font-weight: 700;
    text-decoration: none;
    transition: background-color var(--transition-fast);
  }
  .btn-whatsapp:hover {
    background-color: var(--color-whatsapp-hover);
  }
  .btn-contact {
    background-color: transparent;
    color: #ffffff;
    border: 1px solid #ffffff;
    padding: 0.85rem 1.75rem;
    border-radius: var(--radius-full);
    font-weight: 700;
    text-decoration: none;
    transition: all var(--transition-fast);
  }
  .btn-contact:hover {
    background-color: #ffffff;
    color: var(--color-surface-black);
  }
</style>
