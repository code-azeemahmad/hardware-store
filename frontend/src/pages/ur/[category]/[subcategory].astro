---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProductCard from '../../../components/astro/ProductCard.astro';
import {
  CATEGORIES,
  getProductsBySubcategory,
  type Category,
  type Subcategory,
} from '../../../data/catalogue';

export function getStaticPaths() {
  const paths: {
    params: { category: string; subcategory: string };
    props: { category: Category; subcategory: Subcategory };
  }[] = [];

  CATEGORIES.forEach((cat) => {
    cat.subcategories.forEach((sub) => {
      paths.push({
        params: { category: cat.slug, subcategory: sub.slug },
        props: { category: cat, subcategory: sub },
      });
    });
  });

  return paths;
}

interface Props {
  category: Category;
  subcategory: Subcategory;
}

const { category, subcategory } = Astro.props;
const lang = 'ur';
const products = getProductsBySubcategory(category.slug, subcategory.slug);
---

<BaseLayout
  title={`${subcategory.nameUr} | ${category.nameUr} | نصیر پلائی ووڈ اینڈ ہارڈویئر`}
  description={subcategory.descriptionUr}
  lang={lang}
>
  <!-- Subcategory Header & Breadcrumbs -->
  <section class="subcategory-header">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/ur/">ہوم</a>
        <span class="sep">/</span>
        <a href={`/ur/${category.slug}/`}>{category.nameUr}</a>
        <span class="sep">/</span>
        <span class="current">{subcategory.nameUr}</span>
      </nav>

      <h1 class="subcategory-title">{subcategory.nameUr}</h1>
      <p class="subcategory-desc">{subcategory.descriptionUr}</p>
    </div>
  </section>

  <!-- Filter & Sort Bar -->
  <section class="filter-toolbar-section">
    <div class="container filter-toolbar">
      <div class="filter-left">
        <span class="filter-count">
          دستیاب پراڈکٹس: <strong>{products.length}</strong>
        </span>
      </div>

      <div class="filter-right">
        <label class="sort-label">
          <span>ترتیب:</span>
          <select class="sort-select" aria-label="ترتیب">
            <option value="featured">شوروم سلیکشن</option>
            <option value="bestseller">زیادہ فروخت ہونے والی</option>
            <option value="name-asc">نام کے مطابق</option>
          </select>
        </label>
      </div>
    </div>
  </section>

  <!-- Product Grid -->
  <main class="container catalogue-grid-wrap">
    {products.length > 0 ? (
      <div class="product-cards-grid">
        {products.map((p) => (
          <ProductCard
            title={p.titleUr}
            category={subcategory.nameUr}
            brand={p.brand}
            slug={p.slug}
            imageUrl={p.imageUrl}
            lang={lang}
          />
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <p>اس وقت اس کیٹیگری کے ڈسپلے نمونے اپ ڈیٹ ہو رہے ہیں۔ فوری دستیابی جاننے کے لیے واٹس ایپ کریں۔</p>
        <a href="https://wa.me/923045030046" class="whatsapp-btn" target="_blank" rel="noopener noreferrer">
          واٹس ایپ پر پوچھیں
        </a>
      </div>
    )}

    <!-- Reference Pagination -->
    <nav class="pagination-bar" aria-label="Pagination">
      <span class="page-num active">1</span>
    </nav>
  </main>
</BaseLayout>

<style>
  .subcategory-header {
    background-color: var(--color-surface-light);
    border-bottom: 1px solid var(--color-border);
    padding: 2.25rem 0 1.75rem;
  }
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
  }
  .breadcrumb a {
    color: var(--color-surface-black);
    text-decoration: none;
    font-weight: 600;
  }
  .breadcrumb a:hover {
    color: var(--color-primary-red);
  }
  .breadcrumb .sep {
    color: var(--color-border-hover);
  }
  .subcategory-title {
    font-size: 2.15rem;
    font-weight: 800;
    color: var(--color-surface-black);
    margin-bottom: 0.5rem;
  }
  .subcategory-desc {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    max-width: 750px;
    line-height: 1.8;
  }
  .filter-toolbar-section {
    border-bottom: 1px solid var(--color-border);
    background-color: var(--color-surface-white);
    padding: 0.85rem 0;
  }
  .filter-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .filter-count {
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }
  .filter-count strong {
    color: var(--color-surface-black);
  }
  .sort-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    color: var(--color-text-muted);
  }
  .sort-select {
    padding: 0.4rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-size: 0.95rem;
  }
  .catalogue-grid-wrap {
    padding-top: 2rem;
    padding-bottom: 3.5rem;
  }
  .product-cards-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    margin-bottom: 2rem;
  }
  @media (max-width: 1024px) {
    .product-cards-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }
  }
  @media (max-width: 768px) {
    .product-cards-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
  }
  @media (max-width: 480px) {
    .product-cards-grid {
      grid-template-columns: 1fr;
    }
  }
  .empty-state {
    text-align: center;
    padding: 3rem 1.5rem;
    background-color: var(--color-surface-light);
    border-radius: var(--radius-md);
  }
  .empty-state p {
    color: var(--color-text-muted);
    margin-bottom: 1.25rem;
  }
  .whatsapp-btn {
    display: inline-flex;
    padding: 0.65rem 1.5rem;
    background-color: #25d366;
    color: #ffffff;
    font-weight: 700;
    border-radius: var(--radius-full);
    text-decoration: none;
  }
  .pagination-bar {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }
  .page-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-weight: 600;
    background-color: var(--color-surface-black);
    color: #ffffff;
  }
</style>
