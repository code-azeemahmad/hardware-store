---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProductCard from '../../../components/astro/ProductCard.astro';
import { fetchPublishedCategories, getProductsByCategory, type Category } from '../../../lib/api';

export async function getStaticPaths() {
  const categories = await fetchPublishedCategories();
  return categories.map((category) => ({
    params: { category: category.slug },
    props: { category },
  }));
}

interface Props {
  category: Category;
}

const { category } = Astro.props;
const lang = 'ur';
const products = await getProductsByCategory(category.slug);

const breadcrumbs = [
  { name: 'ہوم', url: '/ur/' },
  { name: category.nameUr, url: `/ur/${category.slug}/` },
];

const collectionSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": `${category.nameUr} | نصیر پلائی ووڈ اینڈ ہارڈویئر`,
  "description": category.descriptionUr,
  "url": `/ur/${category.slug}/`,
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": products.length,
    "itemListElement": products.map((p, idx) => ({
      "@type": "ListItem",
      "position": idx + 1,
      "url": `/ur/products/${p.slug}/`,
      "name": p.titleUr,
    })),
  },
};
---

<BaseLayout
  title={`${category.nameUr} | نصیر پلائی ووڈ اینڈ ہارڈویئر کیٹلاگ`}
  description={category.descriptionUr}
  lang={lang}
  breadcrumbs={breadcrumbs}
  collectionSchema={collectionSchema}
>
  <!-- Category Header & Breadcrumb -->
  <section class="category-header">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/ur/">ہوم</a>
        <span class="sep">/</span>
        <span class="current">{category.nameUr}</span>
      </nav>

      <h1 class="category-title">{category.nameUr}</h1>
      <p class="category-desc">{category.descriptionUr}</p>

      <!-- Subcategory quick links -->
      <div class="subcat-pills">
        {category.subcategories.map((sub) => (
          <a href={`/ur/${category.slug}/${sub.slug}/`} class="subcat-pill">
            {sub.nameUr}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Filter & Sort Bar -->
  <section class="filter-toolbar-section">
    <div class="container filter-toolbar">
      <div class="filter-left">
        <span class="filter-count">
          موجود پراڈکٹس: <strong>{products.length}</strong>
        </span>
      </div>

      <div class="filter-right">
        <label class="sort-label">
          <span>ترتیب:</span>
          <select class="sort-select" aria-label="ترتیب">
            <option value="featured">نمایاں شوروم سلیکشن</option>
            <option value="bestseller">زیادہ فروخت ہونے والی</option>
            <option value="name-asc">نام کے مطابق (الف تا ے)</option>
          </select>
        </label>
      </div>
    </div>
  </section>

  <!-- Product Grid -->
  <div class="container catalogue-grid-wrap">
    <h2 class="sr-only">{category.nameUr} میں دستیاب پراڈکٹس</h2>
    {products.length > 0 ? (
      <div class="product-cards-grid">
        {products.map((p) => (
          <ProductCard
            title={p.titleUr}
            category={p.subcategoryNameUr}
            brand={p.brand}
            slug={p.slug}
            imageUrl={p.imageUrl}
            lang={lang}
          />
        ))}
      </div>
    ) : (
      <div class="empty-state">
        <p>اس کیٹیگری میں فی الحال کوئی پراڈکٹ موجود نہیں۔ کسٹم آرڈر کے لیے رابطہ فرمائیں۔</p>
      </div>
    )}

    <!-- Reference Pagination Controls -->
    <nav class="pagination-bar" aria-label="Pagination">
      <span class="page-num active">1</span>
      <span class="page-num">2</span>
      <span class="page-num">3</span>
      <span class="page-arrow" aria-label="اگلا صفحہ">&gt;</span>
    </nav>
  </div>

  <!-- Bottom Detailed Information -->
  <section class="category-seo-section">
    <div class="container">
      <div class="seo-card">
        <h2>سرگودھا میں ہول سیل اور ریٹیل {category.nameUr} کی فراہمی</h2>
        <p>
          <strong>نصیر پلائی ووڈ اینڈ ہارڈویئر</strong> کنٹریکٹرز، کارپینٹرز اور گھریلو صارفین کو معیاری اور تصدیق شدہ پراڈکٹس فراہم کرتا ہے۔ کینال روڈ شوروم پر تشریف لائیں یا ہول سیل ریٹس اور اسٹاک کی معلومات کے لیے واٹس ایپ پر رابطہ کریں۔
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .category-header {
    background-color: var(--bg-alt);
    border-bottom: 1px solid var(--border);
    padding: 2.5rem 0 2rem;
  }
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    color: var(--text-muted);
    margin-bottom: 1rem;
  }
  .breadcrumb a {
    color: var(--text);
    text-decoration: none;
    font-weight: 600;
  }
  .breadcrumb a:hover {
    color: var(--red-text);
  }
  .breadcrumb .sep {
    color: var(--border);
  }
  .category-title {
    font-size: 2.35rem;
    font-weight: 800;
    color: var(--text);
    margin-bottom: 0.75rem;
  }
  .category-desc {
    font-size: 1.15rem;
    color: var(--text-muted);
    max-width: 800px;
    line-height: 1.8;
    margin-bottom: 1.5rem;
  }
  .subcat-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }
  .subcat-pill {
    display: inline-block;
    padding: 0.5rem 1.15rem;
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
    transition: all var(--transition-fast);
  }
  .subcat-pill:hover {
    border-color: var(--red-text);
    color: var(--red-text);
    background-color: var(--bg-alt);
  }
  .filter-toolbar-section {
    border-bottom: 1px solid var(--border);
    background-color: var(--surface);
    padding: 1rem 0;
  }
  .filter-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }
  .filter-count {
    font-size: 0.95rem;
    color: var(--text-muted);
  }
  .filter-count strong {
    color: var(--text);
  }
  .sort-label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    color: var(--text-muted);
  }
  .sort-select {
    padding: 0.45rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-size: 0.95rem;
    background-color: var(--surface);
    color: var(--text);
    outline: none;
  }
  .sort-select:focus {
    border-color: var(--red-text);
  }
  .catalogue-grid-wrap {
    padding-top: 2rem;
    padding-bottom: 3.5rem;
  }
  .product-cards-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    margin-bottom: 2.5rem;
  }
  @media (max-width: 1024px) {
    .product-cards-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
    }
  }
  @media (max-width: 768px) {
    .product-cards-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }
  }
  @media (max-width: 480px) {
    .product-cards-grid {
      grid-template-columns: 1fr;
    }
  }
  .pagination-bar {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    margin-top: 2rem;
  }
  .page-num, .page-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--text);
    background-color: var(--surface);
    cursor: pointer;
    user-select: none;
  }
  .page-num.active {
    background-color: var(--text);
    color: var(--bg);
    border-color: var(--text);
  }
  .category-seo-section {
    background-color: var(--bg-alt);
    border-top: 1px solid var(--border);
    padding: 3rem 0;
  }
  .seo-card {
    max-width: 900px;
    line-height: 1.9;
    color: var(--text-muted);
  }
  .seo-card h2 {
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.75rem;
  }
</style>
