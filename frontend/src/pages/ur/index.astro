---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { HeroSlider } from '../../components/react/HeroSlider';
import ProductGrid from '../../components/astro/ProductGrid.astro';
import ProductCard from '../../components/astro/ProductCard.astro';
import PlywoodPromoBanner from '../../components/astro/PlywoodPromoBanner.astro';
import { ReviewCarousel } from '../../components/react/ReviewCarousel';
import ShowroomLocation from '../../components/astro/ShowroomLocation.astro';
import SocialBar from '../../components/astro/SocialBar.astro';
import { ui } from '../../i18n/ui';

const lang = 'ur';
---

<BaseLayout
  title="کوالٹی ہارڈویئر اور پلائی ووڈ کیٹلاگ | نصیر ہارڈویئر سرگودھا"
  description="سرگودھا میں کچن فٹنگز، ڈور ہینڈلز، مورٹائز لاکس، باتھ روم سینیٹری اور کمرشل و میرین پلائی ووڈ کا سب سے بڑا شوروم اور کیٹلاگ۔"
  lang={lang}
>
  <!-- Full-Width Hero Slider Island -->
  <HeroSlider client:load lang={lang} />

  <!-- Section 1: Best Seller -->
  <ProductGrid
    title={ui[lang]['section.bestSeller']}
    subtitle={ui[lang]['section.bestSellerSub']}
    viewAllHref="/ur/hardware/"
    lang={lang}
  >
    <ProductCard
      title='T1221 بلٹ اِن الیکٹرک اوون'
      category='کچن اپلائنسز'
      brand='Forza'
      slug='t1221-builtin-oven'
      imageUrl='/images/shelf.jpg'
      lang={lang}
    />
    <ProductCard
      title='DS-681 اسمارٹ ڈیجیٹل ڈور لاک'
      category='ہوم ہارڈویئر'
      brand='DORMA'
      slug='ds-681-smart-door-lock'
      imageUrl='/images/crafts.jpg'
      lang={lang}
    />
    <ProductCard
      title='ZY004 میٹ گولڈ کیبنٹ ہینڈل'
      category='ہارڈویئر فٹنگز'
      brand='نصیر سگنیچر'
      slug='zy004-cabinet-handle'
      imageUrl='/images/crafts.jpg'
      lang={lang}
    />
    <ProductCard
      title='19905 کچن سنگل لیور سنک مکسر'
      category='کچن ٹونٹیاں'
      brand='Forza'
      slug='19905-sink-mixer'
      imageUrl='/images/shelf.jpg'
      lang={lang}
    />
  </ProductGrid>

  <!-- Section 2: Feature Products -->
  <ProductGrid
    title={ui[lang]['section.featured']}
    subtitle={ui[lang]['section.featuredSub']}
    viewAllHref="/ur/bathroom/"
    lang={lang}
  >
    <ProductCard
      title='1129 32" فلوٹنگ باتھ روم وینٹی'
      category='باتھ روم وینٹیز'
      brand='Sanita'
      slug='1129-32-floating-vanity'
      imageUrl='/images/shelf.jpg'
      lang={lang}
    />
    <ProductCard
      title='9322-1 ڈیزائنر سیرامک بیسن'
      category='واش بیسنز'
      brand='Sanita'
      slug='9322-1-designer-basin'
      imageUrl='/images/shelf.jpg'
      lang={lang}
    />
    <ProductCard
      title='1836 ایل ای ڈی اسمارٹ ٹچ مرر'
      category='وینٹی مررز'
      brand='Lumina'
      slug='1836-led-smart-mirror'
      imageUrl='/images/shelf.jpg'
      lang={lang}
    />
    <ProductCard
      title='سولڈ سرفیس کسٹم وینٹی سیٹ'
      category='باتھ روم وینٹیز'
      brand='نصیر سگنیچر'
      slug='custom-vanity-set'
      imageUrl='/images/shelf.jpg'
      lang={lang}
    />
  </ProductGrid>

  <!-- Section 3: Wall Hang Commode -->
  <ProductGrid
    title={ui[lang]['section.wallHang']}
    subtitle={ui[lang]['section.wallHangSub']}
    viewAllHref="/ur/bathroom/"
    lang={lang}
  >
    <ProductCard
      title='A-WHC-014 رِم لیس وال ہینگ کموڈ (میٹ گرے)'
      category='سینیٹری ویئر'
      brand='Sanita'
      slug='a-whc-014-rimless-commode'
      imageUrl='/images/shelf.jpg'
      lang={lang}
    />
    <ProductCard
      title='B-WHC-1 سیرامک کموڈ (وائٹ اور گولڈ رِم)'
      category='سینیٹری ویئر'
      brand='Sanita'
      slug='b-whc-1-white-gold-commode'
      imageUrl='/images/shelf.jpg'
      lang={lang}
    />
    <ProductCard
      title='2303-014 لگژری بلیک اینڈ گولڈ کموڈ'
      category='سینیٹری ویئر'
      brand='Sanita'
      slug='2303-014-black-gold-commode'
      imageUrl='/images/shelf.jpg'
      lang={lang}
    />
    <ProductCard
      title='B-WHC-002-2 پیور وائٹ رِم لیس کموڈ'
      category='سینیٹری ویئر'
      brand='Sanita'
      slug='b-whc-002-2-pure-white-commode'
      imageUrl='/images/shelf.jpg'
      lang={lang}
    />
  </ProductGrid>

  <!-- Section 4: Kitchen Accessories -->
  <ProductGrid
    title={ui[lang]['section.kitchenAccessories']}
    subtitle={ui[lang]['section.kitchenAccessoriesSub']}
    viewAllHref="/ur/kitchen/"
    lang={lang}
  >
    <ProductCard
      title='S910-201 اسٹین لیس اسٹیل ڈش ریک'
      category='کچن اسیسریز'
      brand='Forza'
      slug='s910-201-dish-rack'
      imageUrl='/images/shelf.jpg'
      lang={lang}
    />
    <ProductCard
      title='K004 کٹلری ٹرے اور دراز آرگنائزر'
      category='کچن اسٹوریج'
      brand='Forza'
      slug='k004-cutlery-tray'
      imageUrl='/images/shelf.jpg'
      lang={lang}
    />
    <ProductCard
      title='PT2022 ہیوی ڈیوٹی ٹال پینٹری یونٹ'
      category='کچن اسٹوریج'
      brand='Forza'
      slug='pt2022-tall-pantry-unit'
      imageUrl='/images/shelf.jpg'
      lang={lang}
    />
    <ProductCard
      title='اینگولر ریوالونگ کارنر میجک باسکٹ'
      category='کچن اسٹوریج'
      brand='Forza'
      slug='angular-revolving-corner-basket'
      imageUrl='/images/shelf.jpg'
      lang={lang}
    />
  </ProductGrid>

  <!-- Section 5: Kitchen Handles -->
  <ProductGrid
    title={ui[lang]['section.kitchenHandles']}
    subtitle={ui[lang]['section.kitchenHandlesSub']}
    viewAllHref="/ur/hardware/"
    lang={lang}
  >
    <ProductCard
      title='ZY001 سولڈ براس نورلڈ کیبنٹ ہینڈل'
      category='کیبنٹ ہارڈویئر'
      brand='نصیر سگنیچر'
      slug='zy001-brass-cabinet-handle'
      imageUrl='/images/crafts.jpg'
      lang={lang}
    />
    <ProductCard
      title='B050 میٹ بلیک دراز ہینڈل'
      category='کیبنٹ ہارڈویئر'
      brand='نصیر سگنیچر'
      slug='b050-matte-black-handle'
      imageUrl='/images/crafts.jpg'
      lang={lang}
    />
    <ProductCard
      title='ZY004 شیمپین گولڈ پروفائل ہینڈل'
      category='کیبنٹ ہارڈویئر'
      brand='نصیر سگنیچر'
      slug='zy004-champagne-gold-handle'
      imageUrl='/images/crafts.jpg'
      lang={lang}
    />
    <ProductCard
      title='ZY005 وارڈروب ٹال پل ہینڈل'
      category='الماری ہارڈویئر'
      brand='نصیر سگنیچر'
      slug='zy005-extended-wardrobe-handle'
      imageUrl='/images/crafts.jpg'
      lang={lang}
    />
  </ProductGrid>

  <!-- Section 6: Dedicated Plywood Promotion Highlight Banner -->
  <PlywoodPromoBanner lang={lang} />

  <!-- Section 7: Google Customer Reviews Carousel Island -->
  <ReviewCarousel client:load lang={lang} />

  <!-- Section 8: Showroom Location & Map -->
  <ShowroomLocation lang={lang} />

  <!-- Section 9: Social Connect Bar -->
  <SocialBar lang={lang} />
</BaseLayout>
