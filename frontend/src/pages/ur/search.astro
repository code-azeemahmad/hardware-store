---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SearchCatalogue } from '../../components/react/SearchCatalogue';
import { fetchPublishedProducts } from '../../lib/api';

const lang = 'ur';
const PRODUCTS = await fetchPublishedProducts();

const breadcrumbs = [
  { name: 'ہوم', url: '/ur/' },
  { name: 'تلاش', url: '/ur/search/' },
];
---

<BaseLayout
  title="پراڈکٹ کیٹلاگ تلاش کریں | نصیر پلائی ووڈ اینڈ ہارڈویئر"
  description="نصیر پلائی ووڈ اینڈ ہارڈویئر کے مکمل کیٹلاگ میں ڈور لاکس، کچن سنک، باتھ روم وینٹیز اور میرین پلائی ووڈ تلاش کریں۔"
  lang={lang}
  breadcrumbs={breadcrumbs}
  noindex={true}
>
  <div class="search-page">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/ur/">ہوم</a>
        <span class="sep">/</span>
        <span class="current">تلاش</span>
      </nav>

      <header class="search-page-header">
        <h1 class="page-title">پراڈکٹ کیٹلاگ سرچ</h1>
        <p class="page-subtitle">
          اپنے مطلوبہ ماڈل، ایس کے یو نمبر، برانڈ یا کیٹیگری کے مطابق فوری تلاش کریں۔
        </p>
      </header>

      <SearchCatalogue client:load lang={lang} initialProducts={PRODUCTS} />
    </div>
  </div>
</BaseLayout>

<style>
  .search-page {
    padding-top: 1.5rem;
    padding-bottom: 4rem;
  }
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.95rem;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
  }
  .breadcrumb a {
    color: var(--color-surface-black);
    text-decoration: none;
    font-weight: 600;
  }
  .breadcrumb a:hover {
    color: var(--color-primary-red);
  }
  .breadcrumb .sep {
    color: var(--color-border-hover);
  }
  .search-page-header {
    margin-bottom: 1.5rem;
  }
  .page-title {
    font-size: 2.35rem;
    font-weight: 800;
    color: var(--color-surface-black);
    margin-bottom: 0.5rem;
  }
  .page-subtitle {
    font-size: 1.15rem;
    color: var(--color-text-muted);
    line-height: 1.8;
  }
</style>
