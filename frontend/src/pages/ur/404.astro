---
import BaseLayout from '../../layouts/BaseLayout.astro';

const lang = 'ur';
---

<BaseLayout
  title="صفحہ نہیں ملا (404) | نصیر پلائی ووڈ اینڈ ہارڈویئر"
  description="معذرت، مطلوبہ صفحہ یا پراڈکٹ دستیاب نہیں ہے۔ ہمارے کچن، ہارڈویئر اور پلائی ووڈ کیٹلاگ کو براؤز کریں۔"
  lang={lang}
>
  <div class="not-found-page">
    <div class="container text-center">
      <div class="error-code">404</div>
      <h1 class="error-title">صفحہ نہیں مل سکا</h1>
      <p class="error-desc">
        معذرت، آپ کا مطلوبہ صفحہ یا پراڈکٹ موجود نہیں ہے۔ ممکن ہے اس کا لنک تبدیل ہو گیا ہو یا وہ ہٹا دیا گیا ہو۔
      </p>

      <div class="links-suggestions">
        <a href="/ur/" class="btn-primary">ہوم پیج پر واپس جائیں</a>
        <a href="/ur/search/" class="btn-secondary">کیٹلاگ تلاش کریں</a>
        <a href="https://wa.me/923177030847" class="btn-whatsapp" target="_blank" rel="noopener noreferrer">
          واٹس ایپ پر پوچھیں (0317-7030847)
        </a>
      </div>

      <div class="quick-category-links">
        <span class="quick-label">یا ہماری دیگر کیٹیگریز دیکھیں:</span>
        <div class="pills-row">
          <a href="/ur/kitchen/" class="cat-link">کچن سنک اور ٹونٹیاں</a>
          <a href="/ur/hardware/" class="cat-link">ڈور لاکس اور ہینڈلز</a>
          <a href="/ur/bathroom/" class="cat-link">وینٹیز اور کموڈز</a>
          <a href="/ur/plywood/" class="cat-link">میرین و کمرشل پلائی ووڈ</a>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found-page {
    padding: 6rem 0;
  }
  .text-center {
    text-align: center;
    max-width: 650px;
    margin: 0 auto;
  }
  .error-code {
    font-size: 6rem;
    font-weight: 900;
    color: var(--color-primary-red);
    line-height: 1;
    margin-bottom: 1rem;
  }
  .error-title {
    font-size: 2.35rem;
    font-weight: 800;
    color: var(--color-surface-black);
    margin-bottom: 1rem;
  }
  .error-desc {
    font-size: 1.15rem;
    color: var(--color-text-muted);
    line-height: 1.8;
    margin-bottom: 2.5rem;
  }
  .links-suggestions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 3.5rem;
  }
  .btn-primary {
    background-color: var(--color-surface-black);
    color: #ffffff;
    padding: 0.85rem 1.75rem;
    border-radius: var(--radius-full);
    font-weight: 700;
    text-decoration: none;
    transition: background-color var(--transition-fast);
  }
  .btn-primary:hover {
    background-color: var(--color-primary-red);
  }
  .btn-secondary {
    background-color: var(--color-surface-light);
    color: var(--color-surface-black);
    border: 1px solid var(--color-border);
    padding: 0.85rem 1.75rem;
    border-radius: var(--radius-full);
    font-weight: 700;
    text-decoration: none;
  }
  .btn-whatsapp {
    background-color: var(--color-whatsapp);
    color: #ffffff;
    padding: 0.85rem 1.75rem;
    border-radius: var(--radius-full);
    font-weight: 700;
    text-decoration: none;
    transition: background-color var(--transition-fast);
  }
  .btn-whatsapp:hover {
    background-color: var(--color-whatsapp-hover);
  }
  .quick-category-links {
    border-top: 1px solid var(--color-border);
    padding-top: 2.5rem;
  }
  .quick-label {
    display: block;
    font-size: 0.95rem;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }
  .pills-row {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.65rem;
  }
  .cat-link {
    padding: 0.45rem 1rem;
    background-color: var(--color-surface-light);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--color-surface-black);
    text-decoration: none;
    transition: all var(--transition-fast);
  }
  .cat-link:hover {
    border-color: var(--color-primary-red);
    color: var(--color-primary-red);
  }
</style>
