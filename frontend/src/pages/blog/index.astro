---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { BLOG_POSTS } from '../../data/catalogue';

const lang = 'en';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Guides & Articles', url: '/blog/' },
];
---

<BaseLayout
  title="Hardware & Plywood Buying Guides | Naseer Plywood & Hardware"
  description="Expert guides on choosing commercial vs marine plywood, buying smart digital door locks, and selecting kitchen fittings for homeowners and contractors in Sargodha."
  lang={lang}
  breadcrumbs={breadcrumbs}
>
  <div class="blog-index-page">
    <div class="container">
      <!-- Breadcrumbs -->
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="sep">/</span>
        <span class="current">Guides & Articles</span>
      </nav>

      <!-- Page Header -->
      <header class="blog-header">
        <span class="badge-subtitle">EXPERT TRADE ADVICE</span>
        <h1 class="page-title">Hardware & Plywood Buying Guides</h1>
        <div class="red-line"></div>
        <p class="page-subtitle">
          Professional advice from our Sargodha counter specialists to help you select the exact timber grades, security hardware, and kitchen fittings for your home.
        </p>
      </header>

      <!-- Blog Cards Grid -->
      <div class="blog-grid">
        {BLOG_POSTS.map((post) => (
          <article class="blog-card">
            <a href={`/blog/${post.slug}/`} class="blog-card-img-link">
              <img
                src={post.imageUrl}
                alt={post.titleEn}
                width="600"
                height="400"
                loading="lazy"
                decoding="async"
                class="blog-card-img"
              />
              <span class="blog-cat-badge">{post.categoryEn}</span>
            </a>

            <div class="blog-card-body">
              <div class="blog-meta">
                <span class="blog-date">{post.date}</span>
                <span class="meta-dot">•</span>
                <span class="blog-read-time">{post.readTimeEn}</span>
              </div>

              <h2 class="blog-card-title">
                <a href={`/blog/${post.slug}/`}>{post.titleEn}</a>
              </h2>

              <p class="blog-card-excerpt">{post.excerptEn}</p>

              <a href={`/blog/${post.slug}/`} class="read-more-link">
                Read Full Guide →
              </a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .blog-index-page {
    padding-top: 1.5rem;
    padding-bottom: 4rem;
  }
  .breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
  }
  .breadcrumb a {
    color: var(--text);
    text-decoration: none;
    font-weight: 500;
  }
  .breadcrumb a:hover {
    color: var(--red-text);
  }
  .breadcrumb .sep {
    color: var(--border);
  }
  .blog-header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 3.5rem;
  }
  .badge-subtitle {
    display: inline-block;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--red-text);
    background-color: rgba(228, 30, 38, 0.12);
    border: 1px solid rgba(255, 70, 80, 0.25);
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
    margin-bottom: 0.75rem;
  }
  .page-title {
    font-size: 2.5rem;
    font-weight: 800;
    color: var(--text);
    margin-bottom: 0.5rem;
  }
  .red-line {
    width: 60px;
    height: 3px;
    background-color: var(--red);
    margin: 0.75rem auto 1.5rem;
  }
  .page-subtitle {
    font-size: 1.05rem;
    color: var(--text-muted);
    line-height: 1.6;
  }
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  @media (max-width: 960px) {
    .blog-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 600px) {
    .blog-grid {
      grid-template-columns: 1fr;
    }
  }
  .blog-card {
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast), border-color var(--transition-fast);
  }
  .blog-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: var(--red-text);
  }
  .blog-card-img-link {
    position: relative;
    aspect-ratio: 16 / 10;
    display: block;
    overflow: hidden;
  }
  .blog-card-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform var(--transition-medium);
  }
  .blog-card:hover .blog-card-img {
    transform: scale(1.04);
  }
  .blog-cat-badge {
    position: absolute;
    bottom: 0.75rem;
    left: 0.75rem;
    background-color: var(--topbar);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-sm);
  }
  .blog-card-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }
  .blog-meta {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
  }
  .meta-dot {
    margin: 0 0.4rem;
  }
  .blog-card-title {
    font-size: 1.25rem;
    font-weight: 700;
    line-height: 1.35;
    margin-bottom: 0.75rem;
  }
  .blog-card-title a {
    color: var(--text);
    text-decoration: none;
    transition: color var(--transition-fast);
  }
  .blog-card-title a:hover {
    color: var(--red-text);
  }
  .blog-card-excerpt {
    font-size: 0.9rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 1.25rem;
    flex-grow: 1;
  }
  .read-more-link {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--red-text);
    text-decoration: none;
  }
  .read-more-link:hover {
    text-decoration: underline;
  }
</style>
