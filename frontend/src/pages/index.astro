---
import BaseLayout from '../layouts/BaseLayout.astro';
import { HeroSlider } from '../components/react/HeroSlider';
import ProductGrid from '../components/astro/ProductGrid.astro';
import ProductCard from '../components/astro/ProductCard.astro';
import PlywoodPromoBanner from '../components/astro/PlywoodPromoBanner.astro';
import { ReviewCarousel } from '../components/react/ReviewCarousel';
import ShowroomLocation from '../components/astro/ShowroomLocation.astro';
import SocialBar from '../components/astro/SocialBar.astro';
import { ui } from '../i18n/ui';
import {
  fetchPublishedProducts,
  getProductsByCategory,
} from '../lib/api';

const lang = 'en';
const allProducts = await fetchPublishedProducts();
const bestSellers = allProducts.filter((p) => p.isBestSeller).length > 0
  ? allProducts.filter((p) => p.isBestSeller).slice(0, 4)
  : allProducts.slice(0, 4);

const bathroomProducts = (await getProductsByCategory('bathroom')).slice(0, 4);
const kitchenProducts = (await getProductsByCategory('kitchen')).slice(0, 4);
const hardwareProducts = (await getProductsByCategory('hardware')).slice(0, 4);
---

<BaseLayout
  title="Hardware & Plywood Store | Showroom Catalogue"
  description="Explore Pakistan's finest architectural hardware, door locks, kitchen accessories, bathroom fittings, and commercial & marine plywood in Sargodha."
  lang={lang}
>
  <!-- Full-Width Hero Slider Island -->
  <HeroSlider client:load lang={lang} />

  <!-- Section 1: Best Seller -->
  <ProductGrid
    title={ui[lang]['section.bestSeller']}
    subtitle={ui[lang]['section.bestSellerSub']}
    viewAllHref="/hardware/"
    lang={lang}
  >
    {bestSellers.map((prod) => (
      <ProductCard
        title={prod.titleEn}
        category={prod.subcategoryNameEn || prod.categoryNameEn}
        brand={prod.brand}
        slug={prod.slug}
        imageUrl={prod.imageUrl}
        lang={lang}
      />
    ))}
  </ProductGrid>

  <!-- Section 2: Bathroom Collection -->
  <ProductGrid
    title={ui[lang]['section.featured']}
    subtitle={ui[lang]['section.featuredSub']}
    viewAllHref="/bathroom/"
    lang={lang}
  >
    {bathroomProducts.map((prod) => (
      <ProductCard
        title={prod.titleEn}
        category={prod.subcategoryNameEn || prod.categoryNameEn}
        brand={prod.brand}
        slug={prod.slug}
        imageUrl={prod.imageUrl}
        lang={lang}
      />
    ))}
  </ProductGrid>

  <!-- Section 3: Kitchen Accessories & Sinks -->
  <ProductGrid
    title={ui[lang]['section.kitchenAccessories']}
    subtitle={ui[lang]['section.kitchenAccessoriesSub']}
    viewAllHref="/kitchen/"
    lang={lang}
  >
    {kitchenProducts.map((prod) => (
      <ProductCard
        title={prod.titleEn}
        category={prod.subcategoryNameEn || prod.categoryNameEn}
        brand={prod.brand}
        slug={prod.slug}
        imageUrl={prod.imageUrl}
        lang={lang}
      />
    ))}
  </ProductGrid>

  <!-- Section 4: Architectural Door Hardware -->
  <ProductGrid
    title={ui[lang]['section.kitchenHandles']}
    subtitle={ui[lang]['section.kitchenHandlesSub']}
    viewAllHref="/hardware/"
    lang={lang}
  >
    {hardwareProducts.map((prod) => (
      <ProductCard
        title={prod.titleEn}
        category={prod.subcategoryNameEn || prod.categoryNameEn}
        brand={prod.brand}
        slug={prod.slug}
        imageUrl={prod.imageUrl}
        lang={lang}
      />
    ))}
  </ProductGrid>

  <!-- Section 5: Dedicated Plywood Promotion Highlight Banner -->
  <PlywoodPromoBanner lang={lang} />

  <!-- Section 6: Google Customer Reviews Carousel Island -->
  <ReviewCarousel client:load lang={lang} />

  <!-- Section 7: Showroom Location & Map -->
  <ShowroomLocation lang={lang} />

  <!-- Section 8: Social Connect Bar -->
  <SocialBar lang={lang} />
</BaseLayout>
