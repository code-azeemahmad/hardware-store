---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/astro/ProductCard.astro';
import { EnquiryForm } from '../../components/react/EnquiryForm';
import { FaWhatsapp, FaPhoneAlt } from 'react-icons/fa';
import {
  fetchPublishedProducts,
  getRelatedProducts,
  type Product,
} from '../../lib/api';

declare const process: {
  env: Record<string, string | undefined>;
};

export async function getStaticPaths() {
  const products = await fetchPublishedProducts();
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props;
const lang = 'en';
const relatedProducts = await getRelatedProducts(product.slug, product.categorySlug, 4);

const whatsappHref = `https://wa.me/923177030847?text=${encodeURIComponent(
  `Hello Naseer Plywood & Hardware! I am interested in inquiring about the price and stock of: "${product.titleEn}" (SKU: ${product.sku}).`
)}`;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: product.categoryNameEn, url: `/${product.categorySlug}/` },
  { name: product.subcategoryNameEn, url: `/${product.categorySlug}/${product.subcategorySlug}/` },
  { name: product.titleEn, url: `/products/${product.slug}/` },
];

const siteBase = (process.env.PUBLIC_SITE_URL || Astro.site?.toString() || 'https://naseerhardware.pk').replace(/\/$/, '');
const absoluteImageUrl = product.imageUrl.startsWith('http') ? product.imageUrl : `${siteBase}${product.imageUrl.startsWith('/') ? '' : '/'}${product.imageUrl}`;

const productSchema: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": product.titleEn,
  "image": absoluteImageUrl,
  "description": product.descriptionEn,
  "sku": product.sku,
  ...(product.brand ? {
    "brand": {
      "@type": "Brand",
      "name": product.brand,
    }
  } : {}),
  ...(product.categoryNameEn ? {
    "category": product.categoryNameEn,
  } : {}),
};
---

<BaseLayout
  title={product.metaTitleEn || `${product.titleEn} | Naseer Plywood & Hardware`}
  description={product.metaDescriptionEn || product.descriptionEn.slice(0, 160)}
  lang={lang}
  breadcrumbs={breadcrumbs}
  productSchema={productSchema}
  ogImage={product.imageUrl}
>
  <div class="product-page">
    <div class="container">
      <!-- Breadcrumbs -->
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span class="sep">/</span>
        <a href={`/${product.categorySlug}/`}>{product.categoryNameEn}</a>
        <span class="sep">/</span>
        <a href={`/${product.categorySlug}/${product.subcategorySlug}/`}>
          {product.subcategoryNameEn}
        </a>
        <span class="sep">/</span>
        <span class="current">{product.titleEn}</span>
      </nav>

      <!-- Main Two-Column Layout (Matching reference/item.pdf) -->
      <div class="product-main-grid">
        <!-- Left: Product Media Gallery -->
        <div class="product-gallery">
          <div class="main-image-wrap">
            <img
              src={product.imageUrl}
              alt={product.brand ? `${product.titleEn} - ${product.brand} Architectural Hardware Sargodha` : `${product.titleEn} - Architectural Hardware Sargodha`}
              class="main-image"
              width="600"
              height="600"
              loading="eager"
              fetchpriority="high"
            />
            {product.brand && (
              <div class="brand-badge-overlay">
                <span>{product.brand}</span>
              </div>
            )}
          </div>

          <!-- Thumbnail Strip -->
          <div class="thumbnail-strip">
            {product.gallery.map((img, idx) => (
              <button
                type="button"
                class={`thumb-btn ${idx === 0 ? 'active' : ''}`}
                aria-label={`View ${product.titleEn} image ${idx + 1}`}
              >
                <img
                  src={img}
                  alt={`${product.titleEn} thumbnail ${idx + 1}`}
                  width="80"
                  height="80"
                  loading="lazy"
                  decoding="async"
                />
              </button>
            ))}
          </div>
        </div>

        <!-- Right: Product Information & Inquiries -->
        <div class="product-details">
          <!-- Vendor / Brand Badge -->
          {product.brand && <div class="product-brand-tag">{product.brand.toUpperCase()}</div>}

          <!-- Title -->
          <h1 class="product-title">{product.titleEn}</h1>

          <!-- Meta Row: SKU & Stock Status -->
          <div class="product-meta-row">
            <span class="sku-badge">SKU: <strong>{product.sku}</strong></span>
            {product.inStock && (
              <span class="stock-badge in-stock">
                <span class="pulse-dot"></span> In Stock at Sargodha Showroom
              </span>
            )}
          </div>

          <!-- Price & Inquiry Notice Box -->
          <div class="price-request-box">
            <div class="price-badge-header">
              <span class="price-label">PRICE ON REQUEST</span>
              <span class="price-note">Wholesale & Retail Rates Available</span>
            </div>
            <p class="price-disclaimer">
              Due to daily raw material and currency fluctuations, please contact our showroom directly on WhatsApp or phone for today's most accurate pricing and volume discounts.
            </p>
          </div>

          <!-- Primary Call to Actions (reference/item.pdf vibrant green button) -->
          <div class="action-buttons-group">
            <a
              href={whatsappHref}
              target="_blank"
              rel="noopener noreferrer"
              class="whatsapp-primary-btn"
              data-analytics-event="whatsapp_click"
              data-product-slug={product.slug}
              data-product-name={product.titleEn}
            >
              <FaWhatsapp size={24} />
              <span>REQUEST PRICE ON WHATSAPP</span>
            </a>

            <a
              href="tel:03045030046"
              class="phone-secondary-btn"
              data-analytics-event="call_click"
            >
              <FaPhoneAlt size={20} />
              <span>Call Showroom: 0304-5030046 / 0317-7030847</span>
            </a>
          </div>

          <!-- Product Description -->
          <div class="product-description-wrap">
            <h2 class="section-subheading">Product Overview</h2>
            <p class="description-text">{product.descriptionEn}</p>
          </div>

          <!-- Key Highlights Bulleted List -->
          {product.featuresEn.length > 0 && (
            <div class="product-features-wrap">
              <h2 class="section-subheading">Key Features & Benefits</h2>
              <ul class="features-list">
                {product.featuresEn.map((feat) => (
                  <li>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#E21B23" stroke-width="3">
                      <polyline points="20 6 9 17 4 12"></polyline>
                    </svg>
                    <span>{feat}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}

          <!-- Specifications Table -->
          <div class="product-specs-wrap">
            <h2 class="section-subheading">Technical Specifications</h2>
            <table class="specs-table">
              <tbody>
                {Object.entries(product.specs).map(([key, val]) => (
                  <tr>
                    <th scope="row">{key}</th>
                    <td>{val}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Online Enquiry Form Section -->
      <section class="enquiry-form-section">
        <EnquiryForm
          client:load
          lang={lang}
          prefilledProduct={`${product.titleEn} (SKU: ${product.sku})`}
        />
      </section>

      <!-- Related Products: "You may also like" (reference/item.pdf) -->
      {relatedProducts.length > 0 && (
        <section class="related-products-section">
          <div class="related-header">
            <h2 class="related-title">YOU MAY ALSO LIKE</h2>
            <div class="red-line"></div>
          </div>
          <div class="related-grid">
            {relatedProducts.map((rel) => (
              <ProductCard
                title={rel.titleEn}
                category={rel.subcategoryNameEn}
                brand={rel.brand}
                slug={rel.slug}
                imageUrl={rel.imageUrl}
                lang={lang}
              />
            ))}
          </div>
        </section>
      )}
    </div>
  </div>
</BaseLayout>

<style>
  .product-page {
    padding-top: 1.5rem;
    padding-bottom: 4rem;
  }
  .breadcrumb {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
  }
  .breadcrumb a {
    color: var(--color-surface-black);
    text-decoration: none;
    font-weight: 500;
  }
  .breadcrumb a:hover {
    color: var(--color-primary-red);
  }
  .breadcrumb .sep {
    color: var(--color-border-hover);
  }
  .product-main-grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 3.5rem;
    margin-bottom: 3.5rem;
  }
  @media (max-width: 900px) {
    .product-main-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
  .product-gallery {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .main-image-wrap {
    position: relative;
    aspect-ratio: 1 / 1;
    background-color: var(--color-surface-light);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
  }
  .main-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .brand-badge-overlay {
    position: absolute;
    top: 1rem;
    left: 1rem;
    background-color: rgba(17, 17, 17, 0.88);
    color: #ffffff;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.35rem 0.75rem;
    border-radius: var(--radius-sm);
  }
  .thumbnail-strip {
    display: flex;
    gap: 0.75rem;
  }
  .thumb-btn {
    width: 76px;
    height: 76px;
    border: 2px solid transparent;
    border-radius: var(--radius-sm);
    overflow: hidden;
    cursor: pointer;
    background: none;
    padding: 0;
  }
  .thumb-btn.active {
    border-color: var(--color-primary-red);
  }
  .thumb-btn img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .product-brand-tag {
    font-size: 0.825rem;
    font-weight: 700;
    color: var(--color-text-muted);
    letter-spacing: 0.1em;
    margin-bottom: 0.5rem;
  }
  .product-title {
    font-size: 2.15rem;
    font-weight: 800;
    color: var(--color-surface-black);
    line-height: 1.25;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }
  .product-meta-row {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 1.5rem;
    font-size: 0.875rem;
  }
  .sku-badge {
    color: var(--color-text-muted);
  }
  .sku-badge strong {
    color: var(--color-surface-black);
  }
  .stock-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 600;
    color: #15803d;
    background-color: #dcfce7;
    padding: 0.25rem 0.65rem;
    border-radius: var(--radius-full);
  }
  .pulse-dot {
    width: 8px;
    height: 8px;
    background-color: #16a34a;
    border-radius: 50%;
  }
  .price-request-box {
    background-color: #f8fafc;
    border: 1px solid #e2e8f0;
    border-left: 4px solid var(--color-primary-red);
    padding: 1.25rem;
    border-radius: var(--radius-md);
    margin-bottom: 1.75rem;
  }
  .price-badge-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }
  .price-label {
    font-size: 1.15rem;
    font-weight: 800;
    color: var(--color-primary-red);
    letter-spacing: 0.04em;
  }
  .price-note {
    font-size: 0.8rem;
    font-weight: 600;
    background-color: #e2e8f0;
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
    color: #334155;
  }
  .price-disclaimer {
    font-size: 0.875rem;
    color: #64748b;
    line-height: 1.5;
    margin: 0;
  }
  .action-buttons-group {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 2rem;
  }
  .whatsapp-primary-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    background-color: var(--color-whatsapp);
    color: #ffffff;
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: 0.03em;
    padding: 1rem 1.75rem;
    border-radius: var(--radius-full);
    text-decoration: none;
    box-shadow: 0 4px 14px rgba(13, 110, 56, 0.35);
    transition: background-color var(--transition-fast), transform var(--transition-fast);
  }
  .whatsapp-primary-btn:hover {
    background-color: var(--color-whatsapp-hover);
    transform: translateY(-2px);
  }
  .phone-secondary-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;
    background-color: var(--color-surface-white);
    color: var(--color-surface-black);
    border: 1px solid var(--color-surface-black);
    font-size: 0.95rem;
    font-weight: 700;
    padding: 0.85rem 1.5rem;
    border-radius: var(--radius-full);
    text-decoration: none;
    transition: all var(--transition-fast);
  }
  .phone-secondary-btn:hover {
    background-color: var(--color-surface-black);
    color: #ffffff;
  }
  .section-subheading {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--color-surface-black);
    margin-bottom: 0.75rem;
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--color-border);
  }
  .product-description-wrap {
    margin-bottom: 1.75rem;
  }
  .description-text {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.65;
  }
  .product-features-wrap {
    margin-bottom: 1.75rem;
  }
  .features-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
  }
  .features-list li {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    font-size: 0.925rem;
    color: var(--color-text-muted);
    line-height: 1.45;
  }
  .features-list li svg {
    flex-shrink: 0;
    margin-top: 0.15rem;
  }
  .product-specs-wrap {
    margin-bottom: 2rem;
  }
  .specs-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }
  .specs-table th, .specs-table td {
    padding: 0.65rem 0.85rem;
    border-bottom: 1px solid var(--color-border);
    text-align: left;
  }
  .specs-table th {
    width: 38%;
    font-weight: 600;
    color: var(--color-surface-black);
    background-color: var(--color-surface-light);
  }
  .specs-table td {
    color: var(--color-text-muted);
  }
  .enquiry-form-section {
    margin: 3.5rem 0;
  }
  .related-products-section {
    margin-top: 4rem;
    border-top: 1px solid var(--color-border);
    padding-top: 3rem;
  }
  .related-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }
  .related-title {
    font-size: 1.65rem;
    font-weight: 800;
    color: var(--color-surface-black);
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }
  .red-line {
    width: 48px;
    height: 3px;
    background-color: var(--color-primary-red);
    margin: 0 auto;
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }
  @media (max-width: 1024px) {
    .related-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 480px) {
    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
