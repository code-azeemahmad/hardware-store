---
import { DesktopMegaMenu } from '../react/DesktopMegaMenu';
import { MobileNavDrawer } from '../react/MobileNavDrawer';
import { SearchModal } from '../react/SearchModal';
import { LanguageSwitcher } from '../react/LanguageSwitcher';

interface Props {
  lang: 'en' | 'ur';
}

const { lang } = Astro.props;
const basePath = lang === 'ur' ? '/ur' : '';
const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="container header-container">
    <!-- Left: Mobile Menu Toggle & Brand Logo -->
    <div class="header-left">
      <!-- Mobile Navigation Drawer Island -->
      <MobileNavDrawer client:load lang={lang} currentPath={currentPath} />

      <!-- Brand Logo / Emblem -->
      <a href={basePath || '/'} class="brand-link" aria-label="Naseer Plywood & Hardware">
        <div class="brand-logo-emblem">
          <span class="emblem-initials">NP</span>
        </div>
        <div class="brand-text">
          <span class="brand-title">{lang === 'ur' ? 'نصیر پلائی ووڈ' : 'NASEER PLYWOOD'}</span>
          <span class="brand-subtitle">{lang === 'ur' ? 'اینڈ ہارڈویئر' : '& HARDWARE'}</span>
        </div>
      </a>
    </div>

    <!-- Center: Desktop Mega-Menu Island -->
    <div class="header-center">
      <DesktopMegaMenu client:load lang={lang} currentPath={currentPath} />
    </div>

    <!-- Right: Header Actions (Search, Language Switcher, WhatsApp) -->
    <div class="header-right">
      <!-- Search Modal Island -->
      <SearchModal client:load lang={lang} />

      <!-- Language Switcher Island -->
      <LanguageSwitcher client:load currentLang={lang} currentPath={currentPath} />

      <!-- Direct WhatsApp Action Button -->
      <a
        href="https://wa.me/923045030046"
        target="_blank"
        rel="noopener noreferrer"
        class="whatsapp-quick-btn"
        title="Chat on WhatsApp"
        aria-label="WhatsApp Contact"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.173.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.144.39-.086s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824zm-3.392-12.416c-5.514 0-10 4.486-10 10 0 1.945.565 3.755 1.537 5.289l-1.637 5.979 6.136-1.61c1.476.883 3.204 1.342 4.964 1.342 5.514 0 10-4.486 10-10s-4.486-10-10-10z"/>
        </svg>
      </a>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background-color: var(--color-surface-white);
    border-bottom: 1px solid var(--color-border);
    box-shadow: var(--shadow-sm);
  }

  .header-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: var(--header-height);
  }

  .header-left {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .brand-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .brand-logo-emblem {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: var(--color-secondary-black);
    border: 2px solid var(--color-primary-red);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-surface-white);
    font-weight: 800;
    font-size: 1rem;
    letter-spacing: -0.5px;
    flex-shrink: 0;
  }

  .brand-text {
    display: flex;
    flex-direction: column;
  }

  .brand-title {
    font-size: 1.05rem;
    font-weight: 800;
    color: var(--color-secondary-black);
    letter-spacing: 0.5px;
    line-height: 1.1;
  }

  .brand-subtitle {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--color-primary-red);
    letter-spacing: 1px;
  }

  .header-center {
    display: none;
  }

  @media (min-width: 992px) {
    .header-center {
      display: block;
    }
  }

  .header-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .whatsapp-quick-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background-color: var(--color-whatsapp);
    color: var(--color-surface-white);
    transition: background-color var(--transition-fast), transform var(--transition-fast);
    flex-shrink: 0;
  }

  .whatsapp-quick-btn:hover {
    background-color: var(--color-whatsapp-hover);
    transform: scale(1.05);
  }
</style>
