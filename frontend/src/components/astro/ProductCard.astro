---
import { FaWhatsapp } from 'react-icons/fa';

interface Props {
  title: string;
  category: string;
  brand?: string;
  imageUrl?: string;
  slug: string;
  price?: number;
  priceOnRequest?: boolean;
  lang?: 'en' | 'ur';
}

const {
  title,
  category,
  brand = 'Naseer Hardware',
  imageUrl,
  slug,
  price,
  priceOnRequest = true,
  lang = 'en',
} = Astro.props;

const isUrdu = lang === 'ur';
const basePath = isUrdu ? '/ur' : '';
const productHref = `${basePath}/products/${slug}/`;
const waMessage = encodeURIComponent(
  isUrdu
    ? `السلام علیکم! مجھے اس پروڈکٹ کی قیمت اور تفصیلات درکار ہیں: ${title} (${category})`
    : `Hello! I would like to inquire about current price and availability for: ${title} (${category})`
);
const waUrl = `https://wa.me/923177030847?text=${waMessage}`;
---

<article class="product-card" aria-label={title}>
  <div class="card-media">
    <a href={productHref} class="image-link" tabindex="-1">
      {imageUrl ? (
        <img
          src={imageUrl}
          alt={title}
          width="400"
          height="400"
          loading="lazy"
          decoding="async"
          class="product-img"
        />
      ) : (
        <div class="product-placeholder">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#BBB" stroke-width="1.5">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
            <circle cx="8.5" cy="8.5" r="1.5"></circle>
            <polyline points="21 15 16 10 5 21"></polyline>
          </svg>
        </div>
      )}
    </a>

    <!-- Subtle Brand Watermark Badge (Matching reference audit) -->
    <div class="watermark-badge" title="Verified Store Product">
      <span class="watermark-text">NP</span>
    </div>
  </div>

  <div class="card-info">
    <span class="product-brand">{brand}</span>
    <h3 class="product-title">
      <a href={productHref}>{title}</a>
    </h3>

    <div class="price-action-row">
      <span class="price-status">
        {price && !priceOnRequest 
          ? `PKR ${price.toLocaleString()}` 
          : (isUrdu ? 'قیمت برائے رابطہ' : 'Price on Request')}
      </span>

      <a
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="card-wa-btn"
        title={isUrdu ? 'واٹس ایپ پر قیمت معلوم کریں' : 'Inquire on WhatsApp'}
        aria-label={`Inquire about ${title} on WhatsApp`}
        data-analytics-event="whatsapp_click"
        data-product-slug={slug}
        data-product-name={title}
      >
        <FaWhatsapp size={18} />
      </a>
    </div>
  </div>
</article>

<style>
  .product-card {
    background-color: var(--color-surface-white);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast), border-color var(--transition-fast);
  }

  .product-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: #D0D0D0;
  }

  .card-media {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: var(--color-surface-muted);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .image-link {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .product-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .product-card:hover .product-img {
    transform: scale(1.04);
  }

  .product-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #F8F8F8 0%, #EFEFEF 100%);
  }

  .watermark-badge {
    position: absolute;
    top: 10px;
    inset-inline-end: 10px;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background-color: rgba(17, 17, 17, 0.75);
    border: 1.5px solid var(--color-primary-red);
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    backdrop-filter: blur(2px);
  }

  .watermark-text {
    color: #FFFFFF;
    font-size: 0.625rem;
    font-weight: 800;
  }

  .card-info {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .product-brand {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-text-muted);
    letter-spacing: 0.5px;
    margin-bottom: 0.35rem;
  }

  .product-title {
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--color-secondary-black);
    margin-bottom: 1rem;
    flex: 1;
  }

  .product-title a:hover {
    color: var(--color-primary-red);
  }

  .price-action-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding-top: 0.75rem;
    border-top: 1px solid #F0F0F0;
  }

  .price-status {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-primary-red);
  }

  .card-wa-btn {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background-color: var(--color-whatsapp);
    color: #FFF;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color var(--transition-fast), transform var(--transition-fast);
  }

  .card-wa-btn:hover {
    background-color: var(--color-whatsapp-hover);
    transform: scale(1.1);
  }
</style>
