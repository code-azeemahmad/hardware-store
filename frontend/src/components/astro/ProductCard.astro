---
interface Props {
  title: string;
  category: string;
  brand?: string;
  imageUrl?: string;
  slug: string;
  price?: number;
  priceOnRequest?: boolean;
  lang?: 'en' | 'ur';
}

const {
  title,
  category,
  brand = 'Naseer Hardware',
  imageUrl,
  slug,
  price,
  priceOnRequest = true,
  lang = 'en',
} = Astro.props;

const isUrdu = lang === 'ur';
const basePath = isUrdu ? '/ur' : '';
const productHref = `${basePath}/products/${slug}/`;
const waMessage = encodeURIComponent(
  isUrdu
    ? `السلام علیکم! مجھے اس پروڈکٹ کی قیمت اور تفصیلات درکار ہیں: ${title} (${category})`
    : `Hello! I would like to inquire about current price and availability for: ${title} (${category})`
);
const waUrl = `https://wa.me/923045030046?text=${waMessage}`;
---

<article class="product-card" aria-label={title}>
  <div class="card-media">
    <a href={productHref} class="image-link" tabindex="-1">
      {imageUrl ? (
        <img src={imageUrl} alt={title} loading="lazy" class="product-img" />
      ) : (
        <div class="product-placeholder">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#BBB" stroke-width="1.5">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
            <circle cx="8.5" cy="8.5" r="1.5"></circle>
            <polyline points="21 15 16 10 5 21"></polyline>
          </svg>
        </div>
      )}
    </a>

    <!-- Subtle Brand Watermark Badge (Matching reference audit) -->
    <div class="watermark-badge" title="Verified Store Product">
      <span class="watermark-text">NP</span>
    </div>
  </div>

  <div class="card-info">
    <span class="product-brand">{brand}</span>
    <h3 class="product-title">
      <a href={productHref}>{title}</a>
    </h3>

    <div class="price-action-row">
      <span class="price-status">
        {price && !priceOnRequest 
          ? `PKR ${price.toLocaleString()}` 
          : (isUrdu ? 'قیمت برائے رابطہ' : 'Price on Request')}
      </span>

      <a
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="card-wa-btn"
        title={isUrdu ? 'واٹس ایپ پر قیمت معلوم کریں' : 'Inquire on WhatsApp'}
        aria-label={`Inquire about ${title} on WhatsApp`}
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.173.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.144.39-.086s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824zm-3.392-12.416c-5.514 0-10 4.486-10 10 0 1.945.565 3.755 1.537 5.289l-1.637 5.979 6.136-1.61c1.476.883 3.204 1.342 4.964 1.342 5.514 0 10-4.486 10-10s-4.486-10-10-10z"/>
        </svg>
      </a>
    </div>
  </div>
</article>

<style>
  .product-card {
    background-color: var(--color-surface-white);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform var(--transition-fast), box-shadow var(--transition-fast), border-color var(--transition-fast);
  }

  .product-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
    border-color: #D0D0D0;
  }

  .card-media {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: var(--color-surface-muted);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .image-link {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .product-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .product-card:hover .product-img {
    transform: scale(1.04);
  }

  .product-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #F8F8F8 0%, #EFEFEF 100%);
  }

  .watermark-badge {
    position: absolute;
    top: 10px;
    inset-inline-end: 10px;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background-color: rgba(17, 17, 17, 0.75);
    border: 1.5px solid var(--color-primary-red);
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    backdrop-filter: blur(2px);
  }

  .watermark-text {
    color: #FFFFFF;
    font-size: 0.625rem;
    font-weight: 800;
  }

  .card-info {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .product-brand {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-text-muted);
    letter-spacing: 0.5px;
    margin-bottom: 0.35rem;
  }

  .product-title {
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--color-secondary-black);
    margin-bottom: 1rem;
    flex: 1;
  }

  .product-title a:hover {
    color: var(--color-primary-red);
  }

  .price-action-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding-top: 0.75rem;
    border-top: 1px solid #F0F0F0;
  }

  .price-status {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-primary-red);
  }

  .card-wa-btn {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background-color: var(--color-whatsapp);
    color: #FFF;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color var(--transition-fast), transform var(--transition-fast);
  }

  .card-wa-btn:hover {
    background-color: var(--color-whatsapp-hover);
    transform: scale(1.1);
  }
</style>
