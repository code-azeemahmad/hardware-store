---
import { ui } from '../../i18n/ui';
import { FaMapMarkerAlt, FaPhoneAlt, FaClock, FaDirections, FaWhatsapp } from 'react-icons/fa';

interface Props {
  lang?: 'en' | 'ur';
}

const { lang = 'en' } = Astro.props;
const isUrdu = lang === 'ur';
---

<section class="section showroom-map-section" aria-label="Showroom Location">
  <div class="container">
    <div class="showroom-header">
      <h2 class="showroom-title">{ui[lang]['section.showroom']}</h2>
      <p class="showroom-subtitle">{ui[lang]['section.showroomSub']}</p>
    </div>

    <div class="showroom-layout">
      <!-- Location Details Card -->
      <div class="location-card">
        <div class="location-img-wrap">
          <img
            src="/images/gate.jpg"
            alt={isUrdu ? 'نصیر پلائی ووڈ اینڈ ہارڈویئر شوروم، سرگودھا' : 'Naseer Plywood & Hardware Showroom, Canal Road Sargodha'}
            class="location-thumb-img"
            loading="lazy"
            width="500"
            height="260"
          />
        </div>
        <div class="card-badge">{isUrdu ? 'مرکزی شوروم' : 'Main Showroom'}</div>
        <h3 class="location-name">{isUrdu ? 'نصیر پلائی ووڈ اینڈ ہارڈویئر' : 'Naseer Plywood & Hardware'}</h3>

        <div class="location-detail-item">
          <span class="detail-icon" aria-hidden="true"><FaMapMarkerAlt /></span>
          <div>
            <strong>{isUrdu ? 'پتہ:' : 'Address:'}</strong>
            <p>
              {isUrdu 
                ? 'نزد نیو کینٹ ہسپتال، کینال روڈ / جنرل بس اسٹینڈ روڈ، سرگودھا، پنجاب، پاکستان' 
                : 'Near New Cantt Hospital, Canal Road / General Bus Stand Road, Sargodha, Punjab, Pakistan'}
            </p>
          </div>
        </div>

        <div class="location-detail-item">
          <span class="detail-icon" aria-hidden="true"><FaPhoneAlt /></span>
          <div>
            <strong>{isUrdu ? 'رابطہ نمبرز:' : 'Contact Numbers:'}</strong>
            <p dir="ltr">
              <a href="tel:03045030046">0304-5030046 ({isUrdu ? 'نصیر احمد بھٹی' : 'Naseer Ahmad Bhatti'})</a><br />
              <a href="tel:03177030847">0317-7030847 ({isUrdu ? 'سمیر احمد بھٹی' : 'Sameer Ahmad Bhatti'})</a>
            </p>
          </div>
        </div>

        <div class="location-detail-item">
          <span class="detail-icon" aria-hidden="true"><FaClock /></span>
          <div>
            <strong>{ui[lang]['footer.openingHours']}:</strong>
            <p>{ui[lang]['footer.openingHoursText']}</p>
          </div>
        </div>

        <div class="location-actions">
          <a
            href="https://maps.app.goo.gl/xmLZoo4WbL5xnffy8"
            target="_blank"
            rel="noopener noreferrer"
            class="map-btn map-btn-primary"
          >
            <FaDirections className="btn-icon" />
            <span>{ui[lang]['action.openMaps']}</span>
          </a>
          <a
            href="https://wa.me/923177030847"
            target="_blank"
            rel="noopener noreferrer"
            class="map-btn map-btn-whatsapp"
          >
            <FaWhatsapp className="btn-icon" />
            <span>{ui[lang]['action.whatsapp']}</span>
          </a>
        </div>
      </div>

      <!-- Embedded Google Map -->
      <div class="map-frame-wrapper">
        <iframe
          title="Naseer Plywood & Hardware Location Map"
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d1690.6763544151424!2d72.70518577846164!3d32.05970771747533!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x392177000bb36b05%3A0xdbf7abc5b957c0ae!2sNaseer%20Plywood%20%26%20Hardware%20Store!5e0!3m2!1sen!2s!4v1795111902486!5m2!1sen!2s"
          width="100%"
          height="100%"
          style="border:0;"
          allowfullscreen=""
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="google-map-iframe"
        ></iframe>
      </div>
    </div>
  </div>
</section>

<style>
  .showroom-map-section {
    padding-block: 4.5rem;
    background-color: var(--bg-alt);
  }

  .showroom-header {
    text-align: center;
    max-width: 650px;
    margin-inline: auto;
    margin-bottom: 3rem;
  }

  .showroom-title {
    font-size: clamp(1.75rem, 3.5vw, 2.25rem);
    font-weight: 800;
    color: var(--text);
    margin-bottom: 0.5rem;
  }

  .showroom-subtitle {
    font-size: 0.95rem;
    color: var(--text-muted);
  }

  .showroom-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    background-color: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }

  @media (min-width: 992px) {
    .showroom-layout {
      grid-template-columns: 1fr 1.35fr;
    }
  }

  .location-card {
    padding: clamp(2rem, 3vw, 3rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .location-img-wrap {
    border-radius: var(--radius-md);
    overflow: hidden;
    margin-bottom: 1.25rem;
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.08);
  }

  .location-thumb-img {
    width: 100%;
    height: 180px;
    object-fit: cover;
    display: block;
    transition: transform var(--transition-fast);
  }

  .location-thumb-img:hover {
    transform: scale(1.03);
  }

  .card-badge {
    display: inline-block;
    background-color: var(--red);
    color: var(--on-red);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 0.2rem 0.65rem;
    border-radius: 4px;
    margin-bottom: 1rem;
    align-self: flex-start;
  }

  .location-name {
    font-size: 1.35rem;
    font-weight: 800;
    color: var(--text);
    margin-bottom: 1.5rem;
  }

  .location-detail-item {
    display: flex;
    gap: 0.85rem;
    margin-bottom: 1.25rem;
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .detail-icon {
    font-size: 1.15rem;
    color: var(--red-text);
    flex-shrink: 0;
    margin-top: 0.15rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .btn-icon {
    font-size: 1rem;
    flex-shrink: 0;
  }

  .location-detail-item strong {
    color: var(--text);
    display: block;
    margin-bottom: 0.2rem;
  }

  .location-detail-item p {
    color: var(--text-muted);
    margin: 0;
  }

  .location-detail-item a {
    color: var(--text);
    font-weight: 600;
  }

  .location-detail-item a:hover {
    color: var(--red-text);
  }

  .location-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .map-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    justify-content: center;
    padding: 0.75rem 1.5rem;
    border-radius: 6px;
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .map-btn-primary {
    background-color: var(--btn-dark-bg);
    color: var(--btn-dark-text);
    border: 1px solid var(--btn-dark-border, transparent);
  }

  .map-btn-primary:hover {
    background-color: var(--red);
    color: var(--on-red);
    border-color: var(--red);
  }

  .map-btn-whatsapp {
    background-color: var(--green-whatsapp);
    color: #FFF;
  }

  .map-btn-whatsapp:hover {
    background-color: var(--color-whatsapp-hover);
  }

  .map-frame-wrapper {
    min-height: 380px;
    position: relative;
    background-color: var(--border);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
  }

  .google-map-iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
</style>
