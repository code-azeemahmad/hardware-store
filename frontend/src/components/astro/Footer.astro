---
import { useTranslations } from '../../i18n/utils';

interface Props {
  lang: 'en' | 'ur';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const basePath = lang === 'ur' ? '/ur' : '';
---

<footer class="site-footer">
  <div class="container footer-grid">
    <!-- Showroom Address Column -->
    <div class="footer-col">
      <h3 class="col-title">{t('footer.showroomAddress')}</h3>
      <p class="store-name">{lang === 'ur' ? 'نصیر پلائی ووڈ اینڈ ہارڈویئر' : 'Naseer Plywood & Hardware'}</p>
      <p class="store-address">
        {lang === 'ur' 
          ? 'نزد نیو کینٹ ہسپتال، کینال روڈ / جنرل بس اسٹینڈ روڈ، سرگودھا، پنجاب، پاکستان' 
          : 'Near New Cantt Hospital, Canal Road / General Bus Stand Road, Sargodha, Punjab, Pakistan'}
      </p>
      <p class="store-phone">
        <a href="tel:+923045030046" dir="ltr">+92-304-5030046</a> / <a href="tel:+923177030847" dir="ltr">+92-317-7030847</a>
      </p>
    </div>

    <!-- Contact Info / Links Column -->
    <div class="footer-col">
      <h3 class="col-title">{t('footer.contactInfo')}</h3>
      <ul class="footer-links">
        <li><a href={`${basePath}/about/`}>{t('nav.about')}</a></li>
        <li><a href={`${basePath}/contact/`}>{t('nav.contact')}</a></li>
        <li><a href={`${basePath}/plywood/`}>{t('nav.plywood')}</a></li>
        <li><a href={`${basePath}/kitchen/`}>{t('nav.kitchen')}</a></li>
        <li><a href={`${basePath}/hardware/`}>{t('nav.hardware')}</a></li>
        <li><a href={`${basePath}/bathroom/`}>{t('nav.bathroom')}</a></li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container bottom-content">
      <p>&copy; {new Date().getFullYear()} {lang === 'ur' ? 'نصیر پلائی ووڈ اینڈ ہارڈویئر' : 'Naseer Plywood & Hardware'}. {t('footer.rights')}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-secondary-black);
    color: var(--color-surface-white);
    padding-top: 3.5rem;
    margin-top: auto;
    border-top: 1px solid var(--color-border-dark);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    padding-bottom: 3.5rem;
  }

  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: 2fr 1fr;
    }
  }

  .col-title {
    font-size: 1.125rem;
    font-weight: 700;
    margin-bottom: 1.25rem;
    color: var(--color-surface-white);
    position: relative;
    padding-bottom: 0.5rem;
  }

  .col-title::after {
    content: '';
    position: absolute;
    bottom: 0;
    inset-inline-start: 0;
    width: 36px;
    height: 2px;
    background-color: var(--color-primary-red);
  }

  .store-name {
    font-weight: 700;
    font-size: 1rem;
    margin-bottom: 0.5rem;
    color: var(--color-surface-white);
  }

  .store-address {
    font-size: 0.875rem;
    color: #a0a0a0;
    margin-bottom: 0.75rem;
    line-height: 1.6;
  }

  .store-phone {
    font-size: 0.9375rem;
    color: var(--color-surface-white);
    font-weight: 600;
  }

  .store-phone a:hover {
    color: var(--color-primary-red);
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .footer-links a {
    color: #a0a0a0;
    font-size: 0.875rem;
  }

  .footer-links a:hover {
    color: var(--color-primary-red);
  }

  .footer-bottom {
    background-color: #080808;
    padding-block: 1.25rem;
    font-size: 0.8125rem;
    color: #777777;
    border-top: 1px solid #1c1c1c;
  }

  .bottom-content {
    display: flex;
    justify-content: center;
    text-align: center;
  }
</style>
