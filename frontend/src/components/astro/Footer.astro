---
import { useTranslations } from '../../i18n/utils';
import { FaMapMarkerAlt, FaPhoneAlt, FaWhatsapp, FaClock, FaDirections } from 'react-icons/fa';

interface Props {
  lang: 'en' | 'ur';
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const basePath = lang === 'ur' ? '/ur' : '';
---

<footer class="site-footer">
  <div class="container footer-grid">
    <!-- Showroom Address Column -->
    <div class="footer-col">
      <h3 class="col-title">{t('footer.showroomAddress')}</h3>
      <p class="store-name">{lang === 'ur' ? 'نصیر پلائی ووڈ اینڈ ہارڈویئر' : 'Naseer Plywood & Hardware'}</p>
      
      <div class="footer-info-row">
        <FaMapMarkerAlt className="footer-icon location-icon" />
        <p class="store-address">
          {lang === 'ur' 
            ? 'نزد نیو کینٹ ہسپتال، کینال روڈ / جنرل بس اسٹینڈ روڈ، سرگودھا، پنجاب، پاکستان' 
            : 'Near New Cantt Hospital, Canal Road / General Bus Stand Road, Sargodha, Punjab, Pakistan'}
        </p>
      </div>

      <div class="footer-info-row">
        <FaPhoneAlt className="footer-icon phone-icon" />
        <p class="store-phone">
          <a href="tel:+923045030046" dir="ltr">+92-304-5030046</a> / <a href="tel:+923177030847" dir="ltr">+92-317-7030847</a>
        </p>
      </div>

      <div class="footer-info-row">
        <FaWhatsapp className="footer-icon whatsapp-icon" />
        <p class="store-whatsapp">
          <a href="https://wa.me/923045030046" target="_blank" rel="noopener noreferrer" dir="ltr">
            +92-304-5030046 ({lang === 'ur' ? 'واٹس ایپ برائے آرڈرز' : 'WhatsApp Orders'})
          </a>
        </p>
      </div>

      <div class="footer-info-row">
        <FaClock className="footer-icon clock-icon" />
        <p class="store-hours">
          {lang === 'ur' ? 'پیر تا ہفتہ: 9:00 صبح تا 8:30 شام' : 'Mon - Sat: 9:00 AM – 8:30 PM'}
        </p>
      </div>

      <div class="footer-actions">
        <a 
          href="https://maps.google.com/?q=Canal+Road+Sargodha+Pakistan" 
          target="_blank" 
          rel="noopener noreferrer" 
          class="footer-map-link"
        >
          <FaDirections className="footer-btn-icon" />
          <span>{lang === 'ur' ? 'گوگل میپس پر راستہ دیکھیں' : 'Directions on Google Maps'}</span>
        </a>
      </div>
    </div>

    <!-- Contact Info / Links Column -->
    <div class="footer-col">
      <h3 class="col-title">{t('footer.contactInfo')}</h3>
      <ul class="footer-links">
        <li><a href={`${basePath}/about/`}>{t('nav.about')}</a></li>
        <li><a href={`${basePath}/contact/`}>{t('nav.contact')}</a></li>
        <li><a href={`${basePath}/plywood/`}>{t('nav.plywood')}</a></li>
        <li><a href={`${basePath}/kitchen/`}>{t('nav.kitchen')}</a></li>
        <li><a href={`${basePath}/hardware/`}>{t('nav.hardware')}</a></li>
        <li><a href={`${basePath}/bathroom/`}>{t('nav.bathroom')}</a></li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="container bottom-content">
      <p>&copy; {new Date().getFullYear()} {lang === 'ur' ? 'نصیر پلائی ووڈ اینڈ ہارڈویئر' : 'Naseer Plywood & Hardware'}. {t('footer.rights')}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background-color: var(--color-secondary-black);
    color: var(--color-surface-white);
    padding-top: 3.5rem;
    margin-top: auto;
    border-top: 1px solid var(--color-border-dark);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    padding-bottom: 3.5rem;
  }

  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: 2fr 1fr;
    }
  }

  .col-title {
    font-size: 1.125rem;
    font-weight: 700;
    margin-bottom: 1.25rem;
    color: var(--color-surface-white);
    position: relative;
    padding-bottom: 0.5rem;
  }

  .col-title::after {
    content: '';
    position: absolute;
    bottom: 0;
    inset-inline-start: 0;
    width: 36px;
    height: 2px;
    background-color: var(--color-primary-red);
  }

  .store-name {
    font-weight: 700;
    font-size: 1rem;
    margin-bottom: 0.5rem;
    color: var(--color-surface-white);
  }

  .footer-info-row {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    margin-bottom: 0.625rem;
  }

  .footer-icon {
    font-size: 1rem;
    color: var(--color-primary-red);
    flex-shrink: 0;
    margin-top: 0.2rem;
  }

  .footer-icon.whatsapp-icon {
    color: #25D366;
  }

  .store-address,
  .store-phone,
  .store-whatsapp,
  .store-hours {
    font-size: 0.875rem;
    color: #c0c0c0;
    line-height: 1.5;
    margin: 0;
  }

  .store-phone a,
  .store-whatsapp a {
    color: var(--color-surface-white);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .store-phone a:hover,
  .store-whatsapp a:hover {
    color: var(--color-primary-red);
  }

  .footer-actions {
    margin-top: 1rem;
  }

  .footer-map-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.15);
    color: var(--color-surface-white);
    padding: 0.4rem 0.85rem;
    border-radius: 4px;
    font-size: 0.8125rem;
    text-decoration: none;
    font-weight: 500;
    transition: all 0.2s ease;
  }

  .footer-map-link:hover {
    background-color: var(--color-primary-red);
    border-color: var(--color-primary-red);
    color: #fff;
  }

  .footer-btn-icon {
    font-size: 0.875rem;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .footer-links a {
    color: #a0a0a0;
    font-size: 0.875rem;
  }

  .footer-links a:hover {
    color: var(--color-primary-red);
  }

  .footer-bottom {
    background-color: #080808;
    padding-block: 1.25rem;
    font-size: 0.8125rem;
    color: #9e9e9e;
    border-top: 1px solid #1c1c1c;
  }

  .bottom-content {
    display: flex;
    justify-content: center;
    text-align: center;
  }
</style>
