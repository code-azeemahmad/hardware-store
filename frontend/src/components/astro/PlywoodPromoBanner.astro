---
import { ui } from '../../i18n/ui';

interface Props {
  lang?: 'en' | 'ur';
}

const { lang = 'en' } = Astro.props;
const isUrdu = lang === 'ur';
const basePath = isUrdu ? '/ur' : '';
---

<section class="section plywood-promo-section" aria-label="Plywood & Wood Showcase">
  <div class="container">
    <div class="plywood-card">
      <div class="plywood-content">
        <span class="promo-badge">{isUrdu ? 'سرگودھا ہول سیل ڈسٹری بیوٹر' : 'Sargodha Direct Wholesale'}</span>
        <h2 class="promo-title">{ui[lang]['section.plywoodHighlight']}</h2>
        <p class="promo-text">{ui[lang]['section.plywoodDesc']}</p>

        <!-- Feature Points -->
        <div class="feature-badges">
          <div class="feature-badge">
            <span class="badge-icon">✓</span>
            <span>{isUrdu ? 'بی ڈبلیو آر واٹر پروف میرین پلائی' : 'BWR Waterproof Marine Grade'}</span>
          </div>
          <div class="feature-badge">
            <span class="badge-icon">✓</span>
            <span>{isUrdu ? 'ہائی ڈینسٹی کمرشل شیٹس' : 'High-Density Commercial Sheets'}</span>
          </div>
          <div class="feature-badge">
            <span class="badge-icon">✓</span>
            <span>{isUrdu ? 'ماربل و ووڈ فنش لیمینیٹس' : 'Textured & Marble Laminates'}</span>
          </div>
          <div class="feature-badge">
            <span class="badge-icon">✓</span>
            <span>{isUrdu ? 'میچنگ پی وی سی ایج بینڈنگ رولز' : 'Matching PVC Edge Banding Tapes'}</span>
          </div>
        </div>

        <div class="promo-buttons">
          <a href={`${basePath}/plywood/`} class="btn-promo btn-primary">
            {isUrdu ? 'پلائی ووڈ کیٹلاگ دیکھیں' : 'Explore Plywood Range'}
          </a>
          <a
            href="https://wa.me/923177030847?text=Hi%2C+I+need+wholesale+pricing+for+Plywood+sheets"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-promo btn-whatsapp"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.298.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86.173.086.275.072.376-.044.101-.116.433-.506.549-.68.116-.173.231-.144.39-.086s1.011.477 1.184.564.289.13.332.202c.045.072.045.419-.099.824zm-3.392-12.416c-5.514 0-10 4.486-10 10 0 1.945.565 3.755 1.537 5.289l-1.637 5.979 6.136-1.61c1.476.883 3.204 1.342 4.964 1.342 5.514 0 10-4.486 10-10s-4.486-10-10-10z"/>
            </svg>
            <span>{isUrdu ? 'بلک ریٹس معلوم کریں' : 'Request Contractor Pricing'}</span>
          </a>
        </div>
      </div>

      <div class="plywood-image-col">
        <img src="/images/wood.svg" alt="Plywood Warehouse Stacks" loading="lazy" class="promo-img" />
      </div>
    </div>
  </div>
</section>

<style>
  .plywood-promo-section {
    padding-block: 2rem;
  }

  .plywood-card {
    background: linear-gradient(135deg, #181818 0%, #252525 100%);
    border-radius: 12px;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr;
    color: var(--color-surface-white);
    box-shadow: var(--shadow-lg);
  }

  @media (min-width: 992px) {
    .plywood-card {
      grid-template-columns: 1.25fr 1fr;
    }
  }

  .plywood-content {
    padding: clamp(2rem, 4vw, 3.5rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .promo-badge {
    display: inline-block;
    background-color: var(--color-primary-red);
    color: #FFF;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1px;
    padding: 0.25rem 0.75rem;
    border-radius: 4px;
    margin-bottom: 1.25rem;
    align-self: flex-start;
  }

  .promo-title {
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 1rem;
    color: #FFFFFF;
  }

  .promo-text {
    font-size: 1rem;
    color: #C0C0C0;
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .feature-badges {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.85rem;
    margin-bottom: 2.25rem;
  }

  .feature-badge {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: #E0E0E0;
  }

  .badge-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background-color: var(--color-primary-red);
    color: #FFF;
    font-size: 0.75rem;
    font-weight: 800;
  }

  .promo-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  .btn-promo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.85rem 1.75rem;
    border-radius: 6px;
    font-size: 0.9375rem;
    font-weight: 700;
    text-decoration: none;
    transition: transform var(--transition-fast), background-color var(--transition-fast);
  }

  .btn-primary {
    background-color: var(--color-primary-red);
    color: #FFF;
  }

  .btn-primary:hover {
    background-color: var(--color-primary-red-hover);
    transform: translateY(-2px);
  }

  .btn-whatsapp {
    background-color: var(--color-whatsapp);
    color: #FFF;
  }

  .btn-whatsapp:hover {
    background-color: var(--color-whatsapp-hover);
    transform: translateY(-2px);
  }

  .plywood-image-col {
    position: relative;
    min-height: 320px;
  }

  .promo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
