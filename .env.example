# ==============================================================================
# Naseer Plywood & Hardware — Environment Configuration Template (.env.example)
# ==============================================================================
# Usage:
#   1. Copy this file to '.env':
#      cp .env.example .env
#   2. Adjust values as needed for your local or staging environment.
#   3. For production deployments with SSL, refer to '.env.production.template'.
#   NOTE: NEVER commit '.env' or any real production credentials to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Runtime & Debugging
# ------------------------------------------------------------------------------
APP_ENV=development
DEBUG=True

# ------------------------------------------------------------------------------
# 2. Host Port Bindings
# ------------------------------------------------------------------------------
# Host port mapping for public web service (Nginx).
# Bound to port 80 by default: http://localhost/
FRONTEND_PORT=80

# ------------------------------------------------------------------------------
# 3. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
# Database credentials for local Docker container 'hardware-postgres'.
# In Docker Compose, the database service is isolated on internal port 5432.
POSTGRES_DB=hardware_db
POSTGRES_USER=hardware_user
POSTGRES_PASSWORD=hardware_secure_dev_pass_2026
POSTGRES_HOST=hardware-postgres
POSTGRES_PORT=5432

# SQLAlchemy 2.0 Async/Sync Connection String (psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://hardware_user:hardware_secure_dev_pass_2026@hardware-postgres:5432/hardware_db

# ------------------------------------------------------------------------------
# 4. Security, JWT & Authentication
# ------------------------------------------------------------------------------
# Cryptographic secret key for signing JWT access and refresh tokens.
# Generate a secure 64-character key for production:
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev_secret_hardware_store_key_change_in_production_min32chars!

# Token expiration lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
INVITATION_TOKEN_EXPIRE_HOURS=72

# Initial super admin bootstrap password (used during database seeding)
ADMIN_INITIAL_PASSWORD=AdminPass123!

# ------------------------------------------------------------------------------
# 5. Network, CORS & API Endpoints
# ------------------------------------------------------------------------------
# Comma-separated list of allowed browser origins for CORS requests
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# Canonical public base URL (used for sitemap.xml, canonical tags, and Open Graph)
PUBLIC_SITE_URL=http://localhost

# Publicly accessible backend API URL (proxied through Nginx /api/v1)
PUBLIC_API_URL=http://localhost/api/v1

# Internal Docker network API URL for Astro SSG build-time queries
INTERNAL_API_URL=http://hardware-backend:8000/api/v1

# ------------------------------------------------------------------------------
# 6. Persistent Storage & Directories
# ------------------------------------------------------------------------------
# Path where uploaded product and brand images are stored (mounted Docker volume)
MEDIA_STORAGE_PATH=/data/media

# Root path of frontend source code inside backend container for build triggers
FRONTEND_DIR=/frontend

# ------------------------------------------------------------------------------
# 7. Publishing & SSG Pipeline Controls
# ------------------------------------------------------------------------------
# Set to 'true' in production to abort builds if backend API is unreachable
STRICT_API=false

# Allow fallback to local fixtures if backend API is temporarily offline (dev only)
ALLOW_FIXTURE_FALLBACK=true

# ------------------------------------------------------------------------------
# 8. Search Engine & Analytics Verification (Optional)
# ------------------------------------------------------------------------------
# Google Search Console domain verification HTML tag content
PUBLIC_GSC_VERIFICATION=

# ------------------------------------------------------------------------------
# 9. Business Identity & Showroom Contact Data (NAP)
# ------------------------------------------------------------------------------
STORE_NAME_EN=Naseer Plywood & Hardware
STORE_NAME_UR=نصیر پلائی ووڈ اینڈ ہارڈویئر
STORE_PHONE=+92-304-5030046
STORE_WHATSAPP=+923045030046
STORE_ADDRESS_EN=Near New Cantt Hospital, Canal Road / General Bus Stand Road, Sargodha, Pakistan
STORE_ADDRESS_UR=نزد نیو کینٹ ہسپتال کینال روڈ / جنرل بس اسٹینڈ روڈ، سرگودھا، پاکستان
